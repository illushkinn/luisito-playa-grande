---
import { Icon } from "astro-icon/components";
---
<div id="cart-modal" class="cart-modal" aria-hidden="true" role="dialog" aria-label="Carrito">
  <div class="cart-modal__overlay" data-cart-close></div>
  <div class="cart-modal__content">
    <div class="cart-modal__header">
      <h2 class="cart-modal__title">Mi Pedido</h2>
      <button class="cart-modal__close" data-cart-close aria-label="Cerrar">✕</button>
    </div>

    <div id="cart-empty-state" class="cart-empty">
      <p class="cart-empty__text">Todavia no agregaste nada al pedido</p>
      <a href="/menu" class="cart-empty__cta" data-cart-close>Ver la carta</a>
    </div>

    <div id="cart-content" class="cart-content" style="display:none">
      <div id="cart-items" class="cart-items"></div>

      <div class="cart-summary">
        <div class="cart-summary__row">
          <span>Subtotal</span>
          <span id="cart-subtotal">$0</span>
        </div>
        <div class="cart-summary__row cart-summary__row--total">
          <span>Total</span>
          <span id="cart-total">$0</span>
        </div>
      </div>

      <div class="cart-service">
        <h3 class="cart-service__title">Tipo de servicio</h3>
        <div class="cart-service__options">
          <label class="cart-service__option">
            <input type="radio" name="service" value="delivery" checked />
            <Icon name="lucide:truck" size={16} />
            <span>Delivery a domicilio</span>
          </label>
          <label class="cart-service__option">
            <input type="radio" name="service" value="takeaway" />
            <Icon name="lucide:store" size={16} />
            <span>Pasar a buscar</span>
          </label>
        </div>
      </div>

      <div id="address-field" class="cart-field">
        <label for="address-input">Direccion de entrega</label>
        <input type="text" id="address-input" placeholder="Calle y altura" />
      </div>

      <div class="cart-field">
        <label for="notes-input">Notas (opcional)</label>
        <textarea id="notes-input" placeholder="Ej: sin cebolla, bien cocido..." rows="2"></textarea>
      </div>

      <button id="clear-cart" class="cart-clear">
        <Icon name="lucide:trash-2" size={16} />
        <span>Vaciar pedido</span>
      </button>
      <button id="send-wpp" class="cart-send">
        <Icon name="lucide:send" size={18} />
        <span>Enviar pedido por WhatsApp</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { getCart, updateQty, removeFromCart, getCartTotal, getCartCount, generateWhatsAppMessage, openWhatsApp } from "../utils/cart";

  function renderCart() {
    const items = getCart();
    const empty = document.getElementById("cart-empty-state");
    const content = document.getElementById("cart-content");
    const container = document.getElementById("cart-items");

    if (!empty || !content || !container) return;

    if (items.length === 0) {
      empty.style.display = "block";
      content.style.display = "none";
      return;
    }

    empty.style.display = "none";
    content.style.display = "block";

    container.innerHTML = items.map((item) => `
      <div class="cart-item" data-id="${item.id}">
        <div class="cart-item__info">
          <h4 class="cart-item__name">${item.name}</h4>
          <p class="cart-item__price">$${(item.price * item.qty).toLocaleString("es-AR")}</p>
        </div>
        <div class="cart-item__actions">
          <div class="cart-item__qty">
            <button class="qty-btn btn-icon" data-dec="${item.id}">−</button>
            <span class="qty-value">${item.qty}</span>
            <button class="qty-btn btn-icon" data-inc="${item.id}">+</button>
          </div>
          <button class="cart-item__remove btn-icon" data-remove="${item.id}" aria-label="Eliminar">✕</button>
        </div>
      </div>
    `).join("");

    updateTotals(items);

    container.querySelectorAll("[data-dec]").forEach((btn) =>
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-dec");
        const item = items.find((i) => i.id === id);
        if (item && item.qty > 1) updateQty(id, item.qty - 1);
        else removeFromCart(id);
        renderCart();
        updateBadge();
      })
    );

    container.querySelectorAll("[data-inc]").forEach((btn) =>
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-inc");
        const item = items.find((i) => i.id === id);
        if (item) updateQty(id, item.qty + 1);
        renderCart();
        updateBadge();
      })
    );

    container.querySelectorAll("[data-remove]").forEach((btn) =>
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-remove");
        removeFromCart(id);
        renderCart();
        updateBadge();
      })
    );
  }

  function updateTotals(items) {
    const subtotal = getCartTotal(items);
    const subEl = document.getElementById("cart-subtotal");
    const totalEl = document.getElementById("cart-total");
    if (subEl) subEl.textContent = "$" + subtotal.toLocaleString("es-AR");
    if (totalEl) totalEl.textContent = "$" + subtotal.toLocaleString("es-AR");
  }

  function updateBadge() {
    const badge = document.getElementById("cart-badge");
    if (badge) {
      const items = getCart();
      const count = getCartCount(items);
      badge.textContent = count > 0 ? String(count) : "";
      badge.style.display = count > 0 ? "inline-flex" : "none";
    }
  }

  document.addEventListener("change", (e) => {
    const target = e.target;
    if (target && target instanceof HTMLInputElement && target.name === "service") {
      const addressField = document.getElementById("address-field");
      if (addressField) {
        addressField.style.display = target.value === "delivery" ? "block" : "none";
      }
    }
  });

  document.getElementById("send-wpp")?.addEventListener("click", () => {
    const items = getCart();
    if (items.length === 0) return;
    const type = (document.querySelector("[name=service]:checked"))?.value || "delivery";
    const address = document.getElementById("address-input")?.value || "";
    const notes = document.getElementById("notes-input")?.value || "";

    if (type === "delivery" && !address.trim()) {
      alert("Por favor ingresá tu dirección de entrega");
      return;
    }

    const msg = generateWhatsAppMessage({ items, type: type, address, notes, phone: "" });
    openWhatsApp(msg);
  });

  document.getElementById("clear-cart")?.addEventListener("click", () => {
    if (confirm("¿Vaciar todo el pedido?")) {
      localStorage.removeItem("luisito-cart");
      window.CART_RENDER?.();
      window.CART_UPDATE_BADGE?.();
    }
  });


  window.CART_RENDER = renderCart;
  window.CART_UPDATE_BADGE = updateBadge;
</script>

<style>
  .cart-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }

  .cart-modal--open {
    display: flex;
  }

  .cart-modal__overlay {
    position: absolute;
    inset: 0;
    background: rgba(44, 36, 32, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .cart-modal__content {
    position: relative;
    width: min(520px, 94vw);
    max-height: 88vh;
    overflow-y: auto;
    background: rgba(255, 252, 248, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 2px solid var(--color-text);
    border-radius: var(--radius-sm);
    box-shadow: 6px 6px 0 var(--color-text);
    padding: var(--space-lg);
    animation: cart-fade-in 0.2s ease;
  }

  @keyframes cart-fade-in {
    from { opacity: 0; transform: scale(0.95) translateY(8px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  .cart-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-lg);
  }

  .cart-modal__title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .cart-modal__close {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-cream);
    border: 2px solid var(--color-text);
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    color: var(--color-text);
    border-radius: var(--radius-sm);
    box-shadow: 2px 2px 0 var(--color-text);
    transition: transform 0.1s, box-shadow 0.1s, background 0.15s;
    line-height: 1;
  }

  .cart-modal__close:hover {
    background: oklch(1 0 0);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--color-text);
  }

  .cart-modal__close:active {
    transform: translate(1px, 1px) scale(0.96);
    box-shadow: 1px 1px 0 var(--color-text);
  }

  .cart-empty {
    text-align: center;
    padding: var(--space-xl) var(--space-md);
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-sm);
  }

  .cart-empty__text { font-size: 1rem; color: var(--color-text-muted); margin-bottom: var(--space-lg); }

  .cart-empty__cta {
    display: inline-block;
    padding: var(--space-sm) var(--space-lg);
    background: var(--color-primary);
    color: oklch(1 0 0);
    font-weight: 700;
    text-decoration: none;
    border: 2px solid var(--color-text);
    border-radius: var(--radius-sm);
    box-shadow: 3px 3px 0 var(--color-text);
    transition: transform 0.1s, box-shadow 0.1s, background 0.15s;
  }
  .cart-empty__cta:hover {
    background: var(--color-primary-hover);
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--color-text);
  }
  .cart-empty__cta:active {
    transform: translate(1px, 1px) scale(0.96);
    box-shadow: 1px 1px 0 var(--color-text);
  }

  .cart-content { width: 100%; }

  .cart-items {
    margin-bottom: var(--space-lg);
    max-height: 40vh;
    overflow-y: auto;
    padding-right: 4px;
  }

  .cart-item {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    margin-bottom: var(--space-sm);
    border: 2px solid var(--color-text);
    border-radius: var(--radius-sm);
    box-shadow: 3px 3px 0 var(--color-text);
    transition: transform 0.1s, box-shadow 0.1s, background 0.15s;
  }
  .cart-item:hover {
    background: rgba(250, 246, 241, 0.6);
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--color-text);
  }

  .cart-item:last-child { margin-bottom: 0; }
  .cart-item__info { flex: 1; min-width: 0; }
  .cart-item__name { font-family: var(--font-heading); font-size: 1rem; font-weight: 700; margin-bottom: 2px; overflow-wrap: break-word; hyphens: auto; }
  .cart-item__price { font-size: 0.85rem; font-weight: 700; color: var(--color-primary); }

  .cart-item__actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .cart-item__qty {
    display: flex;
    align-items: center;
    gap: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-hard-sm);
  }

  .btn-icon {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--color-text);
    font-weight: 700;
    cursor: pointer;
    line-height: 1;
    padding: 0;
    transition: transform 0.1s, box-shadow 0.1s, background 0.15s;
  }
  .btn-icon:active {
    transform: scale(0.96);
  }

  .qty-btn {
    font-weight: 800;
    font-size: 1.25rem;
    background: var(--color-accent);
    color: var(--color-text);
    position: relative;
  }
  .qty-btn[data-dec] {
    background: var(--color-cream);
    border-right: none;
  }
  .qty-btn[data-dec]:hover {
    background: oklch(0.92 0.025 70);
    filter: brightness(0.96);
  }
  .qty-btn[data-inc] {
    background: var(--color-accent);
    border-left: none;
  }
  .qty-btn[data-inc]:hover {
    background: var(--color-accent-hover);
    filter: brightness(0.96);
  }
  .qty-btn:active {
    filter: brightness(0.9);
  }

  .qty-value {
    font-weight: 800;
    font-size: 1.05rem;
    min-width: 40px;
    text-align: center;
    padding: 4px 6px;
    background: var(--color-cream);
    border-top: 2px solid var(--color-text);
    border-bottom: 2px solid var(--color-text);
    line-height: 1;
  }

  .cart-item__remove {
    background: var(--color-primary);
    color: oklch(1 0 0);
    font-size: 1.2rem;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-hard);
  }
  .cart-item__remove:hover {
    background: var(--color-primary-hover);
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-hard-lg);
  }
  .cart-item__remove:active {
    transform: translate(1px, 1px) scale(0.96);
    box-shadow: var(--shadow-hard-sm);
  }

  @media (max-width: 480px) {
    .cart-modal__content {
      width: 92vw;
      max-height: 80vh;
      border-radius: 12px;
      padding: var(--space-md);
    }
    .qty-btn {
      width: 44px;
      height: 44px;
      font-size: 1.3rem;
    }
    .qty-value {
      min-width: 44px;
      font-size: 1.1rem;
    }
    .cart-item__remove {
      width: 44px;
      height: 44px;
      font-size: 1.3rem;
    }
  }

  .cart-summary {
    margin-bottom: var(--space-lg);
    border: 2px solid var(--color-text);
    border-radius: var(--radius-sm);
    padding: var(--space-md);
    box-shadow: 3px 3px 0 var(--color-text);
  }

  .cart-summary__row {
    display: flex;
    justify-content: space-between;
    padding: 4px 0;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .cart-summary__row--total {
    font-size: 1.2rem;
    font-weight: 800;
    padding-top: var(--space-sm);
    margin-top: var(--space-xs);
    border-top: 2px solid var(--color-text);
  }

  .cart-service { margin-bottom: var(--space-md); }

  .cart-service__title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: var(--space-md);
  }

  .cart-service__options {
    display: flex;
    gap: var(--space-md);
  }

  .cart-service__option {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    border: 2px solid var(--color-text);
    border-radius: var(--radius-sm);
    box-shadow: 2px 2px 0 var(--color-text);
    transition: transform 0.1s, box-shadow 0.1s, background 0.15s;
  }
  .cart-service__option:hover {
    background: rgba(250, 246, 241, 0.5);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--color-text);
  }
  .cart-service__option:has(input:checked) {
    background: rgba(233, 172, 60, 0.15);
    box-shadow: 3px 3px 0 var(--color-text);
  }

  .cart-field {
    margin-bottom: var(--space-md);
  }

  .cart-field label {
    display: block;
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 6px;
    color: var(--color-text);
  }

  .cart-field input,
  .cart-field textarea {
    width: 100%;
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-body);
    font-size: 0.95rem;
    background: var(--color-cream);
    color: var(--color-text);
    border: 2px solid var(--color-text);
    border-radius: var(--radius-sm);
    box-shadow: inset 2px 2px 0 rgba(0,0,0,0.06);
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .cart-field input:focus,
  .cart-field textarea:focus {
    border-color: var(--color-primary);
    box-shadow: inset 2px 2px 0 rgba(199, 62, 43, 0.1), 0 0 0 3px rgba(199, 62, 43, 0.1);
  }

  .cart-field textarea { resize: vertical; }

  .cart-clear {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: var(--space-sm) var(--space-md);
    margin-top: var(--space-sm);
    background: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    border: 2px solid var(--color-text);
    border-radius: var(--radius-sm);
    box-shadow: 4px 4px 0 var(--color-text);
    transition: transform 0.1s, box-shadow 0.1s, color 0.15s, background 0.15s;
  }
  .cart-clear:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    background: rgba(199, 62, 43, 0.06);
    box-shadow: 6px 6px 0 var(--color-primary);
    transform: translate(-2px, -2px);
  }
  .cart-clear:active {
    transform: translate(1px, 1px) scale(0.96);
    box-shadow: 2px 2px 0 var(--color-primary);
  }

  .cart-send {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: var(--space-md);
    margin-top: var(--space-md);
    background: var(--color-whatsapp);
    color: oklch(1 0 0);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: 0.5px;
    cursor: pointer;
    border: 2px solid var(--color-text);
    border-radius: var(--radius-sm);
    box-shadow: 4px 4px 0 var(--color-text);
    transition: transform 0.1s, box-shadow 0.1s, background 0.15s;
  }
  .cart-send:hover {
    background: var(--color-whatsapp-hover);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--color-text);
  }
  .cart-send:active {
    transform: translate(1px, 1px) scale(0.96);
    box-shadow: 2px 2px 0 var(--color-text);
  }
</style>
