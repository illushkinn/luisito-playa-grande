<button id="theme-toggle" class="btn--icon" aria-label="Cambiar tema">
  <span class="theme-icon" aria-hidden="true">🌙</span>
</button>

<script>
  import { getInitialTheme, toggleTheme, setTheme } from "../utils/theme";
  const btn = document.getElementById("theme-toggle")!;
  const icon = btn.querySelector(".theme-icon")!;
  let current = getInitialTheme();
  setTheme(current);
  icon.textContent = current === "light" ? "🌙" : "☀️";

  btn.addEventListener("click", () => {
    current = toggleTheme(current);
    icon.textContent = current === "light" ? "🌙" : "☀️";
  });
</script>
