---
import { t } from "../utils/i18n";
---

<section class="split-hero">
  <div class="split-hero__visual">
    <img src="/images/logo-cabeza.svg" alt="" class="split-hero__caricature" aria-hidden="true" />
  </div>
  <div class="split-hero__content">
    <h1 class="split-hero__title">Luisito</h1>
    <p class="split-hero__subtitle">{t("hero.subtitle")}</p>
    <div class="split-hero__actions">
      <a href="/menu" class="split-hero__cta">{t("hero.cta")}</a>
      <a href="https://wa.me/5492235440230" target="_blank" rel="noopener" class="split-hero__cta split-hero__cta--wpp">{t("hero.wpp")}</a>
    </div>
  </div>
</section>

<style>
  .split-hero {
    display: flex;
    min-height: 90vh;
  }

  .split-hero__visual {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent);
    padding: var(--space-xl);
    overflow: hidden;
  }

  .split-hero__caricature {
    max-width: 80%;
    max-height: 80%;
    object-fit: contain;
    filter: drop-shadow(8px 8px 0 rgba(0,0,0,0.15));
  }

  .split-hero__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-xl);
    background: var(--color-bg);
  }

  .split-hero__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6rem);
    letter-spacing: 6px;
    color: var(--color-primary);
    line-height: 1;
  }

  .split-hero__subtitle {
    margin-top: var(--space-lg);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    color: var(--color-text-muted);
    max-width: 420px;
    line-height: 1.6;
  }

  .split-hero__actions {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-xl);
    flex-wrap: wrap;
  }

  .split-hero__cta {
    display: inline-block;
    padding: var(--space-md) var(--space-xl);
    background: var(--color-primary);
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    letter-spacing: 2px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .split-hero__cta:hover {
    background: var(--color-primary-hover);
  }

  .split-hero__cta--wpp {
    background: #25d366;
  }

  .split-hero__cta--wpp:hover {
    background: #1da851;
  }

  @media (max-width: 768px) {
    .split-hero {
      flex-direction: column;
      min-height: auto;
    }

    .split-hero__visual {
      min-height: 40vh;
      padding: var(--space-lg);
    }

    .split-hero__caricature {
      max-width: 60%;
      max-height: 60%;
    }

    .split-hero__content {
      align-items: center;
      text-align: center;
      padding: var(--space-lg);
    }

    .split-hero__subtitle {
      max-width: none;
    }

    .split-hero__actions {
      justify-content: center;
    }
  }
</style>
