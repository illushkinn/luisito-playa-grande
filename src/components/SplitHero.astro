---
// Hero section with fullscreen video background
---
<section class="hero">
  <video class="hero__video" autoplay loop muted playsinline preload="auto" poster="/images/hero-image(1).webp">
    <source src="/images/0602-compressed.mp4" type="video/mp4" />
  </video>
  <div class="hero__overlay">
    <h1 class="hero__title">Luisito Playa Grande</h1>
    <p class="hero__subtitle">Almacén &amp; Rotisería · Desde 1955</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-top: calc(-1 * var(--header-height, 0px));
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-bottom: 2px solid var(--color-text);
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero__overlay {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    padding: var(--space-lg);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
  }
  .hero__title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: var(--space-sm);
    color: #fff;
  }
  .hero__subtitle {
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    font-weight: 500;
    opacity: 0.9;
    letter-spacing: 0.02em;
  }

  @media (max-width: 768px) {
    .hero { height: 100dvh; }
  }
</style>
