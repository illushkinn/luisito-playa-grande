---
import { t } from "../utils/i18n";
---

<section class="split-hero">
  <div class="split-hero__visual">
    <img src="/images/logo-cabeza.svg" alt="" class="split-hero__caricature" aria-hidden="true" />
  </div>
  <div class="split-hero__content">
    <h1 class="split-hero__title">
      Bienvenido a
      <img src="/images/luisito-logo-rotiseria-mdq(1).jpg" alt="Luisito Playa Grande" class="split-hero__logo-inline" />
    </h1>
    <p class="split-hero__subtitle">{t("hero.subtitle")}</p>
    <div class="split-hero__actions">
      <a href="/menu" class="split-hero__cta">{t("hero.cta")}</a>
      <a href="https://wa.me/5492235440230" target="_blank" rel="noopener" class="split-hero__cta--wpp">{t("hero.wpp")}</a>
    </div>
  </div>
</section>

<style>
  .split-hero {
    display: flex;
    min-height: 90vh;
  }

  .split-hero__visual {
    flex: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent);
    overflow: hidden;
  }

  .split-hero__caricature {
    width: min(90%, 800px);
    height: auto;
    object-fit: contain;
  }

  .split-hero__content {
    flex: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-xl);
    background: #fff5e0;
  }

  .split-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: 2px;
    color: #000;
    line-height: 1.1;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .split-hero__welcome {
    color: #000;
  }

  .split-hero__logo-inline {
    height: 1.2em;
    width: auto;
    object-fit: contain;
    vertical-align: middle;
  }

  .split-hero__subtitle {
    margin-top: var(--space-md);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: var(--color-primary);
    font-family: var(--font-serif, Georgia, serif);
    max-width: 420px;
    line-height: 1.5;
  }

  .split-hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    margin-top: var(--space-lg);
  }

  .split-hero__cta {
    display: inline-block;
    padding: var(--space-md) var(--space-xl);
    background: #000;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    letter-spacing: 1px;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
  }

  .split-hero__cta:hover {
    background: var(--color-primary);
  }

  .split-hero__cta--wpp {
    font-family: var(--font-sans);
    font-size: clamp(0.9rem, 1.2vw, 1rem);
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }

  .split-hero__cta--wpp:hover {
    color: #25d366;
  }

  @media (max-width: 768px) {
    .split-hero {
      flex-direction: column;
      min-height: auto;
    }

    .split-hero__visual {
      flex: none;
      min-height: 45vh;
    }

    .split-hero__caricature {
      width: min(85%, 500px);
    }

    .split-hero__content {
      flex: none;
      align-items: center;
      text-align: center;
      padding: var(--space-lg);
    }

    .split-hero__title {
      justify-content: center;
    }

    .split-hero__subtitle {
      max-width: none;
    }

    .split-hero__actions {
      justify-content: center;
      flex-direction: column;
      gap: var(--space-md);
    }
  }
</style>
