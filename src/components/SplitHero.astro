---
import { t } from "../utils/i18n";
---

<section class="split-hero">
  <div class="split-hero__visual">
    <img src="/images/logo-cabeza.svg" alt="" class="split-hero__caricature" aria-hidden="true" />
  </div>
  <div class="split-hero__content">
    <h1 class="split-hero__title">
      Bienvenido a
      <img src="/images/luisito-logo-rotiseria-mdq(1).jpg" alt="Luisito Playa Grande" class="split-hero__logo-inline" />
    </h1>
    <p class="split-hero__subtitle" data-i18n="hero.subtitle">{t("hero.subtitle")}</p>
    <div class="split-hero__actions">
      <a href="/menu" class="split-hero__cta" data-i18n="hero.cta">{t("hero.cta")}</a>
      <a href="https://wa.me/5492235440230" target="_blank" rel="noopener" class="split-hero__cta--wpp" data-i18n="hero.wpp">{t("hero.wpp")}</a>
    </div>
  </div>
</section>

<style>
  .split-hero {
    display: flex;
    min-height: 90vh;
  }

  .split-hero__visual {
    flex: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent);
    overflow: hidden;
  }

  .split-hero__caricature {
    width: min(90%, 800px);
    height: auto;
    object-fit: contain;
  }

  .split-hero__content {
    flex: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-xl);
    background: #e8f4f8;
  }

  .split-hero__title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    letter-spacing: 1px;
    color: #000;
    line-height: 1.1;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .split-hero__logo-inline {
    height: 1em;
    width: auto;
    object-fit: contain;
    vertical-align: middle;
    background: #e8f4f8;
  }

  .split-hero__subtitle {
    margin-top: var(--space-md);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: #000;
    max-width: 420px;
    line-height: 1.5;
    white-space: pre-line;
  }

  .split-hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }

  .split-hero__cta {
    display: inline-block;
    padding: var(--space-md) var(--space-xl);
    background: #000;
    color: #fff;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    font-weight: 700;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: var(--radius-md);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
  }

  .split-hero__cta:hover {
    background: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.15);
  }

  .split-hero__cta--wpp {
    display: inline-block;
    padding: var(--space-md) var(--space-xl);
    background: #25d366;
    color: #fff;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    font-weight: 700;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: var(--radius-md);
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.15);
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
  }

  .split-hero__cta--wpp:hover {
    background: #1da851;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(37, 211, 102, 0.25);
  }

  @media (max-width: 768px) {
    .split-hero {
      flex-direction: column;
      min-height: auto;
    }

    .split-hero__visual {
      flex: none;
      min-height: 45vh;
    }

    .split-hero__caricature {
      width: min(85%, 500px);
    }

    .split-hero__content {
      flex: none;
      align-items: center;
      text-align: center;
      padding: var(--space-lg);
    }

    .split-hero__title {
      justify-content: center;
    }

    .split-hero__subtitle {
      max-width: none;
    }

    .split-hero__actions {
      justify-content: center;
      flex-direction: column;
      gap: var(--space-md);
    }
  }
</style>
