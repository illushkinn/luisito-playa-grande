---
import { t } from "../utils/i18n";
import { addToCart } from "../utils/cart";

export interface Props {
  id: string;
  name: string;
  price: number;
  category: string;
  image?: string;
}

const { id, name, price, category, image } = Astro.props;
---

<div class="menu-card" data-id={id}>
  <div class="menu-card__image" role="img" aria-label={name}>
    {image ? (
      <img src={image} alt={name} loading="lazy" data-lightbox={image} />
    ) : (
      <div class="menu-card__placeholder"></div>
    )}
  </div>
  <div class="menu-card__body">
    <h3 class="menu-card__name">{name}</h3>
    <p class="menu-card__price">${price.toLocaleString("es-AR")}</p>
    <div class="menu-card__actions">
      <button class="menu-card__btn" data-add={id}>
        <span data-i18n="menu.add">{t("menu.add")}</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { addToCart } from "../utils/cart";

  document.querySelectorAll("[data-add]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.getAttribute("data-add");
      const card = btn.closest(".menu-card");
      const name = card.querySelector(".menu-card__name")?.textContent || "";
      const priceText = card.querySelector(".menu-card__price")?.textContent || "";
      const price = parseInt(priceText.replace(/[^0-9]/g, ""));

      addToCart({ id, name, price, qty: 1, category: "" } as any);

      const original = btn.innerHTML;
      btn.innerHTML = "Agregado";
      setTimeout(() => { btn.innerHTML = original; }, 1500);

      if (window.updateCartBadge) window.updateCartBadge();
    });
  });
</script>

<style>
  .menu-card {
    overflow: hidden;
    background: var(--card-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 2px solid var(--color-text);
    border-radius: var(--radius-md);
    box-shadow: 4px 4px 0 var(--color-text);
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .menu-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--color-text);
  }

  .menu-card__image {
    width: 100%;
    height: 160px;
    background: var(--color-bg-alt);
    overflow: hidden;
    border-bottom: 2px solid var(--color-text);
  }

  .menu-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .menu-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-light);
  }

  .menu-card__body {
    padding: var(--space-md);
  }

  .menu-card__name {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: var(--space-xs);
  }

  .menu-card__price {
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .menu-card__actions {
    display: flex;
    gap: var(--space-sm);
  }

  .menu-card__btn {
    flex: 1;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-primary);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    border: 2px solid var(--color-text);
    border-radius: var(--radius-sm);
    box-shadow: 3px 3px 0 var(--color-text);
    transition: transform 0.1s, box-shadow 0.1s, background 0.15s;
  }

  .menu-card__btn:hover {
    background: var(--color-primary-hover);
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--color-text);
  }

  .menu-card__btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0 var(--color-text);
  }
</style>
