---
import "../tokens.css";
import Seo from "../components/Seo.astro";
import CartModal from "../components/CartModal.astro";
import Lightbox from "../components/Lightbox.astro";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { Icon } from "astro-icon/components";
import { t } from "../utils/i18n";
import type { SeoProps } from "../components/Seo.astro";

export interface Props extends SeoProps {}

const { title, description, jsonLd } = Astro.props;
const ogImageUrl = Astro.url.origin + "/images/hero-image(1).webp";
const whatsappUrl = "https://wa.me/5492235440230";
const instagramUrl = "https://www.instagram.com/luisito.playagrande/";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="/fonts/Caveat-Bold.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/Caveat-Medium.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/Caveat-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/Caveat-SemiBold.ttf" as="font" type="font/ttf" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Caveat:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/images/luisito-logo-rotiseria-mdq(3)-remove-bg-io.png" />
    <Seo {title} {description} {jsonLd} image={ogImageUrl} />
    <style is:global>
      @font-face {
        font-family: 'Caveat';
        src: url('/fonts/Caveat-Regular.ttf') format('truetype');
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: 'Caveat';
        src: url('/fonts/Caveat-Medium.ttf') format('truetype');
        font-weight: 500;
        font-display: swap;
      }
      @font-face {
        font-family: 'Caveat';
        src: url('/fonts/Caveat-SemiBold.ttf') format('truetype');
        font-weight: 600;
        font-display: swap;
      }
      @font-face {
        font-family: 'Caveat';
        src: url('/fonts/Caveat-Bold.ttf') format('truetype');
        font-weight: 700;
        font-display: swap;
      }
    </style>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }

      /* Custom scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: var(--color-bg-alt);
      }
      ::-webkit-scrollbar-thumb {
        background: var(--color-text-muted);
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: var(--color-text);
      }
      * {
        scrollbar-width: thin;
        scrollbar-color: var(--color-text-muted) var(--color-bg-alt);
      }


      body {
        font-family: var(--font-body);
        color: var(--color-text);
        background: var(--color-bg);
        line-height: 1.6;
        min-height: 100dvh;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        -webkit-tap-highlight-color: transparent;
      }

      body.modal-open {
        overflow: hidden;
      }

      h1, h2, h3, .heading-font {
        font-family: var(--font-heading);
        font-weight: 700;
        text-wrap: balance;
      }

      p { text-wrap: pretty; }

      a {
        color: var(--color-primary);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      a:hover { color: var(--color-accent); }
      .hero__cta--primary:hover,
      .hero__cta--wpp:hover,
      .menu-card__btn:hover,
      .cart-send:hover { color: #fff; }

      a:focus-visible, button:focus-visible {
        outline: 3px solid var(--color-focus);
        outline-offset: 2px;
      }

      .glass {
        background: var(--glass-bg);
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
        box-shadow: var(--glass-shadow);
        border: var(--glass-border);
      }

      .vintage-border {
        border: 2px solid var(--color-text);
        outline: 2px solid var(--color-accent);
        outline-offset: 3px;
      }

      .hard-shadow {
        box-shadow: 4px 4px 0 var(--color-text);
      }

      .noise-overlay {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 9999;
        mix-blend-mode: multiply;
        opacity: 0.08;
      }

      .skip-link {
        position: absolute;
        top: -100%;
        left: var(--space-md);
        padding: var(--space-sm) var(--space-md);
        background: var(--color-primary);
        color: #fff;
        z-index: 1000;
        font-weight: 700;
        text-decoration: none;
      }
      .skip-link:focus { top: 0; }

      .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--space-sm) var(--space-lg);
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        max-width: none;
        z-index: 100;
        min-height: 64px;
      }

      .header.glass {
        background: rgba(250, 246, 241, 0.25);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        box-shadow: 0 4px 32px rgba(44, 36, 32, 0.08);
        border-bottom: 1px solid rgba(255, 255, 255, 0.35);
      }

      .header__brand {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        text-decoration: none;
        color: var(--color-text);
      }

      .header__logo-img {
        width: 72px;
        height: auto;
        aspect-ratio: 1 / 1;
        object-fit: contain;
      }

      .hamburger {
        display: none;
        flex-direction: column;
        gap: 5px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 11px;
        min-width: 44px;
        min-height: 44px;
        align-items: center;
        justify-content: center;
        z-index: 110;
        border-radius: var(--radius-sm);
        -webkit-tap-highlight-color: transparent;
      }
      .hamburger:focus-visible { outline: 2px solid var(--color-primary); }
      .hamburger span {
        display: block;
        width: 22px;
        height: 3px;
        background: var(--color-text);
        border-radius: 2px;
        transform-origin: center;
        transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        will-change: transform, opacity;
      }
      .hamburger.active span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
      .hamburger.active span:nth-child(2) { opacity: 0; }
      .hamburger.active span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

      .mobile-nav {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 105;
      }
      .mobile-nav--open { display: block; }
      .mobile-nav__overlay {
        position: absolute;
        inset: 0;
        background: rgba(250, 246, 241, 0.25);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
      }
      .mobile-nav__panel {
        position: absolute;
        top: 0;
        right: 0;
        width: 100vw;
        max-width: 520px;
        height: 100%;
        background: rgba(250, 246, 241, 0.25);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        padding: var(--space-xl);
        padding-top: calc(var(--space-xl) + env(safe-area-inset-top, 0px));
        padding-right: calc(var(--space-xl) + env(safe-area-inset-right, 0px));
        box-shadow: -4px 0 32px rgba(44, 36, 32, 0.08);
        animation: mobile-slide-in 0.25s ease;
        border-left: 1px solid rgba(255, 255, 255, 0.35);
      }
      @keyframes mobile-slide-in {
        from { transform: translateX(100%); }
        to { transform: translateX(0); }
      }
      .mobile-nav__header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--space-lg);
      }
      .mobile-nav__title {
        font-weight: 700;
        font-size: 1.5rem;
        color: var(--color-text);
      }
      .mobile-nav__close {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: var(--color-text);
        border-radius: var(--radius-sm);
      }
      .mobile-nav__close:hover { background: rgba(44,36,32,0.08); }
      .mobile-nav__list {
        list-style: none;
        margin-bottom: var(--space-xl);
      }
      .mobile-nav__link {
        display: block;
        padding: var(--space-lg) 0;
        font-weight: 700;
        font-size: 1.3rem;
        color: var(--color-text);
        text-decoration: none;
        border-bottom: 1px solid rgba(44,36,32,0.1);
        letter-spacing: 0;
      }
      .mobile-nav__link:hover { color: var(--color-accent); }
      .mobile-nav__actions {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
      }
      .mobile-nav__cart {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: var(--space-md) var(--space-lg);
        background: #fff;
        border: 2px solid var(--color-text);
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--color-text);
        cursor: pointer;
        border-radius: var(--radius-sm);
        box-shadow: 3px 3px 0 var(--color-text);
        transition: transform 0.1s, box-shadow 0.1s, background 0.15s;
        position: relative;
        -webkit-tap-highlight-color: transparent;
      }
      .mobile-nav__cart:hover {
        background: #f5f5f5;
        color: var(--color-text);
        transform: translate(-1px, -1px);
        box-shadow: 4px 4px 0 var(--color-text);
      }
      .mobile-nav__cart:active {
        transform: translate(1px, 1px) scale(0.96);
        box-shadow: 1px 1px 0 var(--color-text);
      }
      .mobile-nav__cart-badge {
        display: none;
        position: absolute;
        top: -4px;
        right: -4px;
        min-width: 18px;
        height: 18px;
        align-items: center;
        justify-content: center;
        background: var(--color-primary);
        color: #fff;
        font-size: 0.65rem;
        font-weight: 800;
        padding: 0 4px;
        border-radius: 9px;
        box-shadow: 0 2px 4px rgba(199, 62, 43, 0.3);
      }

      .wpp-float {
        display: none;
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 90;
        width: 56px;
        height: 56px;
        align-items: center;
        justify-content: center;
        background: #25d366;
        color: #fff;
        border: 2px solid var(--color-text);
        border-radius: var(--radius-sm);
        box-shadow: 4px 4px 0 var(--color-text);
        text-decoration: none;
        transition: transform 0.1s, box-shadow 0.1s;
      }
      .wpp-float:hover {
        transform: translate(-1px, -1px);
        box-shadow: 5px 5px 0 var(--color-text);
        color: #fff;
      }
      .wpp-float:active {
        transform: translate(1px, 1px) scale(0.96);
        box-shadow: 2px 2px 0 var(--color-text);
      }

      .header--scrolled {
        background: rgba(250, 246, 241, 0.92) !important;
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
      }

      .nav {
        display: flex;
        align-items: center;
        gap: var(--space-md);
      }

      .nav__list {
        display: flex;
        gap: var(--space-md);
        list-style: none;
      }

      .nav__link {
        font-family: var(--font-heading);
        font-size: 1rem;
        font-weight: 600;
        color: var(--color-text);
        text-decoration: none;
        padding: var(--space-xs) var(--space-sm);
        letter-spacing: 0;
        transition: color 0.15s;
      }

      .nav__link:hover { color: var(--color-accent); }

      .nav__controls {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
      }

      .cart-toggle {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--font-body);
        font-size: 0.85rem;
        font-weight: 600;
        background: var(--color-cream);
        border: 2px solid var(--color-text);
        outline: none;
        cursor: pointer;
        text-decoration: none;
        color: var(--color-text);
        padding: var(--space-xs) var(--space-sm);
        border-radius: var(--radius-sm);
        box-shadow: 3px 3px 0 var(--color-text);
        transition: transform 0.1s, box-shadow 0.1s, background 0.15s;
      }

      .cart-toggle:hover {
        background: #fff;
        transform: translate(-1px, -1px);
        box-shadow: 4px 4px 0 var(--color-text);
      }

      .cart-toggle:active {
        transform: translate(1px, 1px) scale(0.96);
        box-shadow: 1px 1px 0 var(--color-text);
      }

      #cart-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-left: 4px;
        background: var(--color-primary);
        color: #fff;
        font-family: var(--font-body);
        font-size: 0.7rem;
        font-weight: 800;
        min-width: 20px;
        height: 20px;
        padding: 0 5px;
        border-radius: 10px;
        display: none;
        vertical-align: middle;
        box-shadow: 0 2px 6px rgba(199, 62, 43, 0.3);
      }

      .main {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: var(--space-lg);
        padding-top: var(--header-height);
        min-height: 70vh;
        background: var(--color-bg);
        border-radius: 2px;
      }

      .footer {
        padding: var(--space-xl) var(--space-lg);
        background: var(--color-footer-bg);
        box-shadow: 0 -2px 0 var(--color-text), 0 -4px 0 var(--color-accent);
      }

      .footer__inner {
        max-width: var(--max-width);
        margin: 0 auto;
      }

      .footer__brand {
        text-align: center;
        margin-bottom: var(--space-lg);
      }

      .footer__logo-name {
        font-family: var(--font-heading);
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: var(--space-xs);
        letter-spacing: 0;
      }
      .footer__logo-img {
        width: 72px;
        height: 72px;
        max-width: 100%;
        object-fit: contain;
        margin-bottom: var(--space-sm);
      }

      @media (max-width: 768px) {
        .footer__logo-img {
          width: 56px;
          height: 56px;
        }
      }

      .footer__since {
        font-size: 0.75rem;
        color: var(--color-text-muted);
        font-style: italic;
        font-weight: 400;
      }

      .footer__flip {
        display: flex;
        gap: var(--space-xl);
        margin-bottom: var(--space-lg);
        position: relative;
        align-items: flex-start;
      }
      .footer__flip-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-lg);
        width: 50%;
        max-width: 480px;
        margin-left: var(--space-lg);
      }
      .footer__flip-visual {
        width: 280px;
        height: 200px;
        background: var(--color-footer-bg) url(/images/luisito-gente.png) no-repeat center / cover;
        border: 2px solid var(--color-text);
        box-shadow: 4px 4px 0 var(--color-text);
        align-self: flex-start;
        flex-shrink: 0;
        image-rendering: auto;
      }

      .footer__section-title {
        font-family: var(--font-heading);
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: var(--space-sm);
        color: var(--color-text);
      }

      .footer__item {
        margin-bottom: var(--space-xs);
        font-size: 0.85rem;
        line-height: 1.5;
        color: var(--color-text-muted);
      }

      .footer__item a {
        color: var(--color-text);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .footer__social {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
      }

      .footer__social-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: underline;
        text-underline-offset: 2px;
        color: var(--color-text);
      }

      .footer__divider {
        border: none;
        border-top: 1px solid var(--color-border);
        margin-bottom: var(--space-lg);
        direction: ltr;
      }


      .footer__bottom {
        text-align: center;
        font-size: 0.75rem;
        color: var(--color-text-muted);
      }

      .footer__bottom p {
        margin-bottom: var(--space-xs);
      }

      .footer__top-wrap {
        display: flex;
        justify-content: center;
        margin-top: var(--space-lg);
      }
      .footer__top-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: var(--space-sm) var(--space-lg);
        background: var(--color-accent);
        color: var(--color-text);
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        border: 2px solid var(--color-text);
        border-radius: var(--radius-sm);
        box-shadow: 4px 4px 0 var(--color-text);
        transition: transform 0.1s, box-shadow 0.1s, background 0.1s;
      }
      .footer__top-btn:hover {
        background: #e8a040;
        transform: translate(-1px, -1px);
        box-shadow: 5px 5px 0 var(--color-text);
      }
      .footer__top-btn:active {
        transform: translate(1px, 1px) scale(0.96);
        box-shadow: 2px 2px 0 var(--color-text);
      }

      .section-title {
        font-family: var(--font-heading);
        font-size: 2.25rem;
        text-align: center;
        margin-bottom: var(--space-lg);
        font-weight: 700;
        color: var(--color-text);
      }

      .wpp-float { display: flex; }

      @media (max-width: 768px) {
        :root { --header-height: 80px; }
        .hamburger { display: flex; }
        .header.glass { background: rgba(250, 246, 241, 0.25); }
        .header { flex-wrap: nowrap; gap: 0; padding: var(--space-xs) var(--space-md); }
        .header__logo-img { width: 64px; height: 64px; }
        .nav { display: none; }
        .main { padding: var(--space-md); padding-top: var(--header-height); }
        .section-title { font-size: 1.875rem; margin-bottom: var(--space-md); }
        .categories { padding: var(--space-lg) 0; }
        .destacados { padding: var(--space-lg) 0; }
        .footer__flip { flex-direction: column; gap: var(--space-sm); }
        .footer__flip-content { width: 100%; max-width: 100%; gap: var(--space-sm); margin-left: 0; }
        .footer__flip-visual { width: 100%; height: 240px; background: var(--color-footer-bg) url(/images/luisito-gente.png) no-repeat center / cover; border: 2px solid var(--color-text); box-shadow: 4px 4px 0 var(--color-text); }
        .footer__actions { flex-direction: column; align-items: center; }
        .footer { padding: var(--space-lg) var(--space-md); }
        .footer__divider { margin-bottom: var(--space-md); }
        .footer__top-wrap { margin-top: var(--space-md); }
      }
    </style>
    <script is:inline>if(history.scrollRestoration)history.scrollRestoration="manual";window.scrollTo(0,0);window.addEventListener("pageshow",function(e){if(e.persisted)window.scrollTo(0,0)});</script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t("accessibility.skipToContent")}</a>

    <header class="header glass" role="banner" id="header">
      <a href="/" class="header__brand">
        <img src="/images/luisito-logo-rotiseria-mdq(3)-remove-bg-io.png" alt="Luisito Playa Grande" class="header__logo-img" width="96" height="96" />
      </a>
      <button class="hamburger" id="hamburger-btn" aria-label="Abrir menú" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <nav class="nav" aria-label={t("accessibility.navLabel")}>
        <ul class="nav__list">
          <li><a href="/" class="nav__link">{t("nav.home")}</a></li>
          <li><a href="/menu" class="nav__link">{t("nav.menu")}</a></li>
          <li><a href="/contact" class="nav__link">{t("nav.contact")}</a></li>
        </ul>
        <div class="nav__controls">
          <button class="cart-toggle" id="cart-toggle-btn" aria-label={t("nav.order")}>
            <Icon name="lucide:shopping-bag" size={16} /> {t("nav.order")}<span id="cart-badge"></span>
          </button>
        </div>
      </nav>
    </header>

    <div class="mobile-nav" id="mobile-nav">
      <div class="mobile-nav__overlay" id="mobile-nav-overlay"></div>
      <div class="mobile-nav__panel">
        <div class="mobile-nav__header">
          <span class="mobile-nav__title">Menú</span>
          <button class="mobile-nav__close" id="mobile-nav-close" aria-label="Cerrar">✕</button>
        </div>
        <ul class="mobile-nav__list">
          <li><a href="/" class="mobile-nav__link">{t("nav.home")}</a></li>
          <li><a href="/menu" class="mobile-nav__link">{t("nav.menu")}</a></li>
          <li><a href="/contact" class="mobile-nav__link">{t("nav.contact")}</a></li>
        </ul>
        <div class="mobile-nav__actions">
          <button class="mobile-nav__cart" id="mobile-nav-cart"><Icon name="lucide:shopping-bag" size={16} /> {t("nav.order")}<span id="mobile-cart-badge" class="mobile-nav__cart-badge"></span></button>
        </div>
      </div>
    </div>

    <main id="main-content" class="main" role="main">
      <slot />
    </main>

    <footer class="footer" role="contentinfo" aria-label={t("accessibility.footerLabel")}>
      <div class="footer__inner">

        <div class="footer__flip">
          <div class="footer__flip-visual" role="img" aria-label="Luisito y su gente"></div>
          <div class="footer__flip-content">
            <div>
              <p class="footer__section-title">Contacto</p>
              <p class="footer__item">{t("contact.address")}</p>
              <p class="footer__item">{t("contact.phone")}</p>
            </div>
            <div>
              <p class="footer__section-title">Horarios</p>
              <p class="footer__item">{t("contact.hours")}</p>
            </div>
            <div>
              <p class="footer__section-title">Redes</p>
              <div class="footer__social">
                <a href={instagramUrl} target="_blank" rel="noopener" class="footer__social-link"><Icon name="lucide:instagram" size={14} /> Instagram</a>
                <a href={whatsappUrl} target="_blank" rel="noopener" class="footer__social-link"><Icon name="lucide:message-circle" size={14} /> WhatsApp</a>
              </div>
            </div>
          </div>
        </div>

        <hr class="footer__divider" />

        
        <div class="footer__bottom">
          <p>{t("footer.copyright", { year: new Date().getFullYear() })}</p>
          <p class="footer__made">Hecho con amor en Mar del Plata.</p>
        </div>

        <div class="footer__top-wrap">
          <button class="footer__top-btn" id="footer-top-btn" aria-label="Volver arriba">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
            <span>Volver arriba</span>
          </button>
        </div>
      </div>
    </footer>

    <Lightbox />
    <CartModal />

    <a href={whatsappUrl} target="_blank" rel="noopener" class="wpp-float" aria-label="WhatsApp">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/></svg>
    </a>

    <svg class="noise-overlay" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
      <filter id="vintage-noise">
        <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch" />
        <feColorMatrix type="saturate" values="0" />
      </filter>
      <rect width="100%" height="100%" filter="url(#vintage-noise)" />
    </svg>
    <Analytics />
    <SpeedInsights />

    <script>
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      gsap.registerPlugin(ScrollTrigger);

      window.addEventListener("load", () => {
        if (window.location.hash) history.replaceState(null, "", window.location.pathname);
        window.scrollTo(0, 0);
        ScrollTrigger.create({
          start: "top -80px",
          onEnter: () => document.getElementById("header")?.classList.add("header--scrolled"),
          onLeaveBack: () => document.getElementById("header")?.classList.remove("header--scrolled"),
        });
        var footer = document.querySelector(".footer");
        if (footer) {
          ScrollTrigger.create({
            trigger: footer,
            start: "top bottom",
            onEnter: function() {
              var h = document.getElementById("header");
              if (h) { h.style.position = "relative"; h.style.top = "auto"; }
            },
            onLeaveBack: function() {
              var h = document.getElementById("header");
              if (h) { h.style.position = ""; h.style.top = ""; }
            }
          });
        }
      });
    </script>

    <script>
      function openMobileNav() {
        document.getElementById("mobile-nav")?.classList.add("mobile-nav--open");
        document.getElementById("hamburger-btn")?.classList.add("active");
        document.getElementById("hamburger-btn")?.setAttribute("aria-expanded", "true");
        document.body.classList.add("modal-open");
      }
      function closeMobileNav() {
        document.getElementById("mobile-nav")?.classList.remove("mobile-nav--open");
        document.getElementById("hamburger-btn")?.classList.remove("active");
        document.getElementById("hamburger-btn")?.setAttribute("aria-expanded", "false");
        document.body.classList.remove("modal-open");
      }

      document.getElementById("hamburger-btn")?.addEventListener("click", openMobileNav);
      document.getElementById("mobile-nav-close")?.addEventListener("click", closeMobileNav);
      document.getElementById("mobile-nav-overlay")?.addEventListener("click", closeMobileNav);
      document.getElementById("mobile-nav-cart")?.addEventListener("click", () => { closeMobileNav(); window.openCartModal?.(); });
      document.querySelectorAll(".mobile-nav__link").forEach((link) => link.addEventListener("click", closeMobileNav));
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeMobileNav(); });
    </script>

    <script>
      const badge = document.getElementById("cart-badge");
      const mobileBadge = document.getElementById("mobile-cart-badge");
      function updateBadge() {
        try {
          const items = JSON.parse(localStorage.getItem("luisito-cart") || "[]");
          const count = items.reduce((s, i) => s + i.qty, 0);
          if (badge) {
            if (count > 0) { badge.textContent = String(count); badge.style.display = "inline-flex"; }
            else { badge.textContent = ""; badge.style.display = "none"; }
          }
          if (mobileBadge) {
            if (count > 0) { mobileBadge.textContent = String(count); mobileBadge.style.display = "inline-flex"; }
            else { mobileBadge.textContent = ""; mobileBadge.style.display = "none"; }
          }
        } catch {}
      }
      updateBadge();

      function openCartModal() {
        const modal = document.getElementById("cart-modal");
        if (!modal) return;
        modal.classList.add("cart-modal--open");
        document.body.classList.add("modal-open");
        if (window.CART_RENDER) window.CART_RENDER();
      }

      function closeCartModal() {
        const modal = document.getElementById("cart-modal");
        if (!modal) return;
        modal.classList.remove("cart-modal--open");
        document.body.classList.remove("modal-open");
      }

      document.getElementById("cart-toggle-btn")?.addEventListener("click", openCartModal);

      document.addEventListener("click", function(e) {
        var target = e.target;
        if (target && (target.getAttribute("data-cart-close") !== null || target.closest("[data-cart-close]"))) {
          closeCartModal();
        }
      });

      document.addEventListener("keydown", function(e) {
        if (e.key === "Escape") closeCartModal();
      });

      window.openCartModal = openCartModal;
      window.closeCartModal = closeCartModal;
      window.updateCartBadge = updateBadge;
    </script>

    <script>
      document.getElementById("footer-top-btn")?.addEventListener("click", function() {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    </script>

<!-- i18n eliminado — sitio 100% español rioplatense -->
  </body>
</html>
