---
import Seo from "../components/Seo.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { t, getLocale } from "../utils/i18n";
import type { SeoProps } from "../components/Seo.astro";
import es from "../content/i18n/es.json";
import en from "../content/i18n/en.json";

export interface Props extends SeoProps {}

const locale = getLocale();
const { title, description, jsonLd } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <Seo {title} {description} {jsonLd} />
    <style>
      :root {
        --color-bg: #e8f4f8;
        --color-bg-alt: #d0e8f0;
        --color-text: #000;
        --color-text-muted: #000;
        --color-primary: #0d7986;
        --color-primary-hover: #0a5f6a;
        --color-accent: #f5c800;
        --color-border: #000;
        --color-focus: #0d7986;
        --color-cream: #fff5e0;
        --font-sans: "Inter", system-ui, sans-serif;
        --border-width: 0;
        --space-xs: 0.25rem;
        --space-sm: 0.5rem;
        --space-md: 1rem;
        --space-lg: 2rem;
        --space-xl: 4rem;
        --max-width: 1100px;
        --radius-sm: 4px;
        --radius-md: 8px;
        --card-bg: rgba(255, 255, 255, 0.85);
        --glass-bg: rgba(232, 244, 248, 0.85);
        --glass-border: 1px solid rgba(255, 255, 255, 0.4);
        --glass-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
        --glass-blur: 12px;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }

      body {
        font-family: var(--font-sans);
        color: var(--color-text);
        background: var(--color-bg);
        line-height: 1.6;
        min-height: 100vh;
      }

      a {
        color: var(--color-primary);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      a:hover { color: var(--color-primary-hover); }

      a:focus-visible, button:focus-visible {
        outline: 3px solid var(--color-focus);
        outline-offset: 2px;
      }

      .glass {
        background: var(--glass-bg);
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
        box-shadow: var(--glass-shadow);
        border: var(--glass-border);
      }

      .skip-link {
        position: absolute;
        top: -100%;
        left: var(--space-md);
        padding: var(--space-sm) var(--space-md);
        background: var(--color-primary);
        color: #fff;
        z-index: 1000;
        font-weight: 700;
        text-decoration: none;
      }
      .skip-link:focus { top: 0; }

      .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--space-md) var(--space-lg);
        max-width: var(--max-width);
        margin: 0 auto;
        position: sticky;
        top: 0;
        z-index: 100;
      }

      .header__brand {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        text-decoration: none;
        color: var(--color-text);
      }

      .header__logo-img {
        width: 72px;
        height: 72px;
        object-fit: contain;
      }

      .header__title {
        font-size: 1.75rem;
        font-weight: 700;
        letter-spacing: 4px;
        color: var(--color-text);
      }

      .nav {
        display: flex;
        align-items: center;
        gap: var(--space-lg);
      }

      .nav__list {
        display: flex;
        gap: var(--space-md);
        list-style: none;
      }

      .nav__link {
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--color-text);
        text-decoration: none;
        padding: var(--space-xs) var(--space-sm);
        letter-spacing: 0.5px;
        transition: color 0.15s;
      }

      .nav__link:hover { color: var(--color-primary); }

      .nav__controls {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
      }

      .btn--icon {
        padding: var(--space-sm) var(--space-md);
        cursor: pointer;
        font-weight: 700;
        font-size: 0.875rem;
        transition: transform 0.15s;
      }

      .btn--icon:hover { transform: scale(1.1); }

      .lang-btn {
        letter-spacing: 1px;
        background: var(--color-accent);
      }

      .cart-toggle {
        position: relative;
        font-size: 1.25rem;
        background: transparent;
        border: none;
        outline: none;
        text-decoration: none;
        color: var(--color-text);
      }

      #cart-badge {
        position: absolute;
        top: -6px;
        right: -6px;
        background: var(--color-primary);
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        width: 20px;
        height: 20px;
        border-radius: var(--radius-md);
        display: none;
        align-items: center;
        justify-content: center;
      }

      .main {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: var(--space-lg);
        min-height: 70vh;
      }

      .footer {
        padding: var(--space-xl) var(--space-lg);
        margin-top: var(--space-xl);
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
      }

      .footer__inner {
        max-width: var(--max-width);
        margin: 0 auto;
      }

      .footer__brand {
        text-align: center;
        margin-bottom: var(--space-xl);
      }

      .footer__logo-name {
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: 2px;
        margin-bottom: var(--space-xs);
      }

      .footer__since {
        font-size: 0.9rem;
        color: var(--color-text);
        font-weight: 400;
      }

      .footer__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-xl);
        margin-bottom: var(--space-xl);
      }

      .footer__section-title {
        font-size: 0.8rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: var(--space-md);
      }

      .footer__item {
        display: flex;
        align-items: flex-start;
        gap: var(--space-sm);
        margin-bottom: var(--space-sm);
        font-size: 0.9rem;
        line-height: 1.5;
      }

      .footer__item-icon {
        flex-shrink: 0;
        font-size: 1rem;
      }

      .footer__divider {
        border: none;
        border-top: 1px solid rgba(0, 0, 0, 0.1);
        margin-bottom: var(--space-lg);
      }

      .footer__actions {
        display: flex;
        justify-content: center;
        gap: var(--space-lg);
        margin-bottom: var(--space-lg);
        flex-wrap: wrap;
      }

      .footer__cta {
        display: inline-block;
        padding: var(--space-sm) var(--space-lg);
        font-weight: 700;
        font-size: 0.9rem;
        text-decoration: none;
        border-radius: var(--radius-md);
        transition: transform 0.15s;
      }

      .footer__cta:hover {
        transform: translateY(-1px);
      }

      .footer__cta--wpp {
        background: #25d366;
        color: #fff;
      }

      .footer__cta--menu {
        background: var(--color-primary);
        color: #fff;
      }

      .footer__bottom {
        text-align: center;
        font-size: 0.8rem;
        color: var(--color-text);
      }

      .footer__bottom p {
        margin-bottom: var(--space-xs);
      }

      .footer__made {
        font-weight: 600;
      }

      .section-title {
        font-size: 2.5rem;
        text-align: center;
        margin-bottom: var(--space-lg);
        font-weight: 700;
        color: var(--color-text);
      }

      @media (max-width: 768px) {
        .header { flex-wrap: wrap; gap: var(--space-sm); }
        .nav { order: 3; width: 100%; justify-content: space-between; }
        .nav__list { gap: var(--space-xs); }
        .nav__link { font-size: 1rem; }
        .section-title { font-size: 1.75rem; }
        .footer__grid { grid-template-columns: 1fr; gap: var(--space-lg); }
        .footer__actions { flex-direction: column; align-items: center; }
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t("accessibility.skipToContent")}</a>

    <header class="header glass" role="banner">
      <a href="/" class="header__brand">
        <img src="/images/luisito-logo-rotiseria-mdq(1).jpg" alt="Luisito Playa Grande" class="header__logo-img" />
      </a>
      <nav class="nav" aria-label={t("accessibility.navLabel")}>
        <ul class="nav__list">
          <li><a href="/" class="nav__link">{t("nav.home")}</a></li>
          <li><a href="/menu" class="nav__link">{t("nav.menu")}</a></li>
          <li><a href="/contact" class="nav__link">{t("nav.contact")}</a></li>
        </ul>
        <div class="nav__controls">
          <a href="/pedido" class="cart-toggle" aria-label={t("nav.order")}>
            🛒<span id="cart-badge"></span>
          </a>
          <LanguageSwitcher />
        </div>
      </nav>
    </header>

    <main id="main-content" class="main" role="main">
      <slot />
    </main>

    <footer class="footer" role="contentinfo" aria-label={t("accessibility.footerLabel")}>
      <div class="footer__inner">
        <div class="footer__brand">
          <p class="footer__logo-name">Luisito Playa Grande</p>
          <p class="footer__since">{t("footer.tagline")}</p>
        </div>

        <div class="footer__grid">
          <div>
            <p class="footer__section-title">Contacto</p>
            <div class="footer__item">
              <span class="footer__item-icon">📍</span>
              <span>{t("contact.address")}</span>
            </div>
            <div class="footer__item">
              <span class="footer__item-icon">📱</span>
              <span>{t("contact.phone")}</span>
            </div>
          </div>
          <div>
            <p class="footer__section-title">Horarios</p>
            <div class="footer__item">
              <span class="footer__item-icon">🕐</span>
              <span>{t("contact.hours")}</span>
            </div>
          </div>
          <div>
            <p class="footer__section-title">Encontranos</p>
            <div class="footer__item">
              <span class="footer__item-icon">📍</span>
              <span>Bernardo de Irigoyen 3537, Mar del Plata</span>
            </div>
            <div class="footer__item">
              <span class="footer__item-icon">📸</span>
              <a href="https://www.instagram.com/luisito.playagrande/" target="_blank" rel="noopener">@luisito.playagrande</a>
            </div>
          </div>
        </div>

        <hr class="footer__divider" />

        <div class="footer__actions">
          <a href="https://wa.me/5492235440230" target="_blank" rel="noopener" class="footer__cta footer__cta--wpp">📱 Pedí por WhatsApp</a>
          <a href="/menu" class="footer__cta footer__cta--menu">🍽️ Ver la Carta</a>
        </div>

        <div class="footer__bottom">
          <p>{t("footer.copyright", { year: new Date().getFullYear() })}</p>
          <p class="footer__made">Hecho con amor en Mar del Plata 🧉</p>
        </div>
      </div>
    </footer>

    <script>
      const badge = document.getElementById("cart-badge");
      if (badge) {
        try {
          const items = JSON.parse(localStorage.getItem("luisito-cart") || "[]");
          const count = items.reduce((s, i) => s + i.qty, 0);
          if (count > 0) { badge.textContent = String(count); badge.style.display = "flex"; }
        } catch {}
      }
    </script>

    <script define:vars={{ esData: es, enData: en }}>
      function resolveKey(obj, key) {
        return key.split(".").reduce((o, k) => (o && o[k] !== undefined ? o[k] : undefined), obj);
      }

      function applyLocale(locale) {
        var locales = { es: esData, en: enData };
        if (!locales[locale]) return;
        document.documentElement.lang = locale;

        document.querySelectorAll("[data-i18n]").forEach(function(el) {
          var key = el.getAttribute("data-i18n");
          var value = resolveKey(locales[locale], key);
          if (typeof value === "string") el.textContent = value;
        });

        document.querySelectorAll("[data-i18n-attr]").forEach(function(el) {
          var key = el.getAttribute("data-i18n-attr");
          var attr = el.getAttribute("data-i18n-attr-name") || "aria-label";
          var value = resolveKey(locales[locale], key);
          if (typeof value === "string") el.setAttribute(attr, value);
        });

        localStorage.setItem("locale", locale);
      }

      var stored = localStorage.getItem("locale");
      if (stored && stored !== document.documentElement.lang) {
        applyLocale(stored);
      }

      window.applyLocale = applyLocale;
    </script>
  </body>
</html>
