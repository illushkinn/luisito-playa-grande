---
import Seo from "../components/Seo.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import CartModal from "../components/CartModal.astro";
import Lightbox from "../components/Lightbox.astro";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { Icon } from "astro-icon/components";
import { t, getLocale } from "../utils/i18n";
import type { SeoProps } from "../components/Seo.astro";
import es from "../content/i18n/es.json";
import en from "../content/i18n/en.json";

export interface Props extends SeoProps {}

const locale = getLocale();
const { title, description, jsonLd } = Astro.props;
const ogImageUrl = Astro.url.origin + "/images/luisito-logo-rotiseria-mdq(2)-remove-bg-io.png";
const whatsappUrl = "https://wa.me/5492235440230";
const instagramUrl = "https://www.instagram.com/luisito.playagrande/";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/images/luisito-logo-rotiseria-mdq(2)-remove-bg-io.png" />
    <Seo {title} {description} {jsonLd} image={ogImageUrl} />
    <style is:global>
      :root {
        --color-bg: #ece3d8;
        --color-bg-alt: #e0d5c8;
        --color-text: #2c2420;
        --color-text-muted: #6b6259;
        --color-primary: #c73e2b;
        --color-primary-hover: #a83222;
        --color-accent: #d4943a;
        --color-accent-light: #f5e6c8;
        --color-border: rgba(44, 36, 32, 0.12);
        --color-focus: #c73e2b;
        --color-cream: #faf6f1;
        --color-footer-bg: #d4c8b8;
        --font-heading: "Inter", system-ui, sans-serif;
        --font-body: "Inter", system-ui, sans-serif;
        --font-accent: "Inter", system-ui, sans-serif;
        --border-width: 0;
        --space-xs: 0.25rem;
        --space-sm: 0.5rem;
        --space-md: 1rem;
        --space-lg: 2rem;
        --space-xl: 4rem;
        --max-width: 960px;
        --radius-sm: 2px;
        --radius-md: 4px;
        --card-bg: rgba(255, 252, 248, 0.92);
        --glass-bg: rgba(250, 246, 241, 0.85);
        --glass-border: 1px solid rgba(255, 255, 255, 0.5);
        --glass-shadow: 0 4px 24px rgba(44, 36, 32, 0.06);
        --glass-blur: 12px;
      }
    </style>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }

      /* Custom scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: var(--color-bg-alt);
      }
      ::-webkit-scrollbar-thumb {
        background: var(--color-text-muted);
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: var(--color-text);
      }
      * {
        scrollbar-width: thin;
        scrollbar-color: var(--color-text-muted) var(--color-bg-alt);
      }


      body {
        font-family: var(--font-body);
        color: var(--color-text);
        background: var(--color-bg);
        line-height: 1.6;
        min-height: 100vh;
      }

      body.modal-open {
        overflow: hidden;
      }

      h1, h2, h3, .heading-font {
        font-family: var(--font-heading);
        font-weight: 700;
      }

      a {
        color: var(--color-primary);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      a:hover { color: var(--color-accent); }
      .nav__cta-wpp:hover, .hero__cta:hover, .hero__cta--wpp:hover,
      .mobile-nav__wpp:hover,
      .destacado-card__btn:hover, .menu-card__btn:hover,
      .cart-send:hover { color: #fff !important; }

      a:focus-visible, button:focus-visible {
        outline: 3px solid var(--color-focus);
        outline-offset: 2px;
      }

      .glass {
        background: var(--glass-bg);
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
        box-shadow: var(--glass-shadow);
        border: var(--glass-border);
      }

      .vintage-border {
        border: 2px solid var(--color-text);
        outline: 2px solid var(--color-accent);
        outline-offset: 3px;
      }

      .hard-shadow {
        box-shadow: 4px 4px 0 var(--color-text);
      }

      .noise-overlay {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 9999;
        mix-blend-mode: multiply;
        opacity: 0.08;
      }

      .skip-link {
        position: absolute;
        top: -100%;
        left: var(--space-md);
        padding: var(--space-sm) var(--space-md);
        background: var(--color-primary);
        color: #fff;
        z-index: 1000;
        font-weight: 700;
        text-decoration: none;
      }
      .skip-link:focus { top: 0; }

      .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--space-md) var(--space-lg);
        max-width: var(--max-width);
        margin: 0 auto;
        position: sticky;
        top: 0;
        z-index: 100;
      }

      .header.glass {
        background: rgba(250, 246, 241, 0.25);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        box-shadow: 0 4px 32px rgba(44, 36, 32, 0.08);
        border-bottom: 1px solid rgba(255, 255, 255, 0.35);
      }

      .header__brand {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        text-decoration: none;
        color: var(--color-text);
      }

      .header__logo-img {
        width: 64px;
        height: 64px;
        object-fit: contain;
      }

      .hamburger {
        display: none;
        flex-direction: column;
        gap: 5px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 11px;
        min-width: 44px;
        min-height: 44px;
        align-items: center;
        justify-content: center;
        z-index: 110;
      }
      .hamburger span {
        display: block;
        width: 22px;
        height: 2px;
        background: var(--color-text);
        border-radius: 1px;
        transition: transform 0.25s, opacity 0.25s;
      }
      .hamburger.active span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
      .hamburger.active span:nth-child(2) { opacity: 0; }
      .hamburger.active span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

      .mobile-nav {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 105;
      }
      .mobile-nav--open { display: block; }
      .mobile-nav__overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.4);
      }
      .mobile-nav__panel {
        position: absolute;
        top: 0;
        right: 0;
        width: 280px;
        height: 100%;
        background: #faf6f1;
        padding: var(--space-lg);
        box-shadow: -4px 0 24px rgba(0,0,0,0.1);
        animation: mobile-slide-in 0.25s ease;
      }
      @keyframes mobile-slide-in {
        from { transform: translateX(100%); }
        to { transform: translateX(0); }
      }
      .mobile-nav__header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--space-lg);
      }
      .mobile-nav__title {
        font-weight: 700;
        font-size: 1.1rem;
      }
      .mobile-nav__close {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: none;
        font-size: 1.25rem;
        cursor: pointer;
        color: var(--color-text);
        border-radius: var(--radius-sm);
      }
      .mobile-nav__close:hover { background: rgba(0,0,0,0.06); }
      .mobile-nav__list {
        list-style: none;
        margin-bottom: var(--space-xl);
      }
      .mobile-nav__link {
        display: block;
        padding: var(--space-md) 0;
        font-weight: 600;
        color: var(--color-text);
        text-decoration: none;
        border-bottom: 1px solid var(--color-border);
      }
      .mobile-nav__actions {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
      }
      .mobile-nav__wpp {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: var(--space-sm) var(--space-md);
        background: #25d366;
        color: #fff;
        font-weight: 600;
        text-decoration: none;
        border-radius: var(--radius-sm);
      }
      .mobile-nav__cart {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: var(--space-sm) var(--space-md);
        background: transparent;
        border: 1px solid var(--color-border);
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--color-text);
        cursor: pointer;
        border-radius: var(--radius-sm);
      }
      .mobile-nav__lang {
        display: flex;
        justify-content: center;
        margin-top: var(--space-sm);
      }

      .header--scrolled {
        background: rgba(250, 246, 241, 0.92) !important;
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
      }

      .nav {
        display: flex;
        align-items: center;
        gap: var(--space-md);
      }

      .nav__list {
        display: flex;
        gap: var(--space-md);
        list-style: none;
      }

      .nav__link {
        font-family: var(--font-heading);
        font-size: 1rem;
        font-weight: 600;
        color: var(--color-text);
        text-decoration: none;
        padding: var(--space-xs) var(--space-sm);
        letter-spacing: 0;
        transition: color 0.15s;
      }

      .nav__link:hover { color: var(--color-accent); }

      .nav__controls {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
      }

      .nav__cta-wpp {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: var(--space-xs) var(--space-md);
        background: #25d366;
        color: #fff;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.8rem;
        cursor: pointer;
        border: none;
        border-radius: var(--radius-sm);
        text-decoration: none;
        transition: opacity 0.15s, transform 0.15s;
        white-space: nowrap;
      }

      .nav__cta-wpp:hover {
        opacity: 0.9;
        transform: translateY(-1px);
      }

      .lang-btn {
        letter-spacing: 0.5px;
        background: var(--color-accent);
        font-family: var(--font-body);
        font-size: 0.8rem;
        font-weight: 600;
        padding: var(--space-xs) var(--space-sm);
        cursor: pointer;
        border: none;
        border-radius: var(--radius-sm);
        transition: transform 0.15s;
      }

      .lang-btn:hover { transform: scale(1.05); }

      .cart-toggle {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--font-body);
        font-size: 0.85rem;
        font-weight: 600;
        background: transparent;
        border: none;
        outline: none;
        cursor: pointer;
        text-decoration: none;
        color: var(--color-text);
        padding: var(--space-xs) var(--space-sm);
        border-radius: var(--radius-sm);
        transition: background 0.15s;
      }

      .cart-toggle:hover {
        background: rgba(0,0,0,0.04);
      }

      #cart-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-left: 4px;
        background: var(--color-primary);
        color: #fff;
        font-family: var(--font-body);
        font-size: 0.7rem;
        font-weight: 800;
        min-width: 20px;
        height: 20px;
        padding: 0 5px;
        border-radius: 10px;
        display: none;
        vertical-align: middle;
        box-shadow: 0 2px 6px rgba(199, 62, 43, 0.3);
      }

      .main {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: var(--space-lg);
        min-height: 70vh;
        background: var(--color-bg);
        border-radius: 2px;
      }

      .info-strip {
        padding: var(--space-md) var(--space-lg);
        background: var(--color-footer-bg);
      }

      .info-strip__inner {
        max-width: var(--max-width);
        margin: 0 auto;
        display: flex;
        justify-content: center;
        gap: var(--space-xl);
        flex-wrap: wrap;
      }

      .info-strip__item {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--color-text-muted);
      }

      .info-strip__item a {
        color: var(--color-text);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .footer {
        padding: var(--space-xl) var(--space-lg);
        background: var(--color-footer-bg);
        box-shadow: 0 -2px 0 var(--color-text), 0 -4px 0 var(--color-accent);
      }

      .footer__inner {
        max-width: var(--max-width);
        margin: 0 auto;
      }

      .footer__brand {
        text-align: center;
        margin-bottom: var(--space-lg);
      }

      .footer__logo-name {
        font-family: var(--font-heading);
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: var(--space-xs);
        letter-spacing: 0;
      }
      .footer__logo-img {
        width: 72px;
        height: 72px;
        max-width: 100%;
        object-fit: contain;
        margin-bottom: var(--space-sm);
      }

      @media (max-width: 768px) {
        .footer__logo-img {
          width: 56px;
          height: 56px;
        }
      }

      .footer__since {
        font-size: 0.75rem;
        color: #000;
        font-style: italic;
        font-weight: 400;
      }

      .footer__flip {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-xl);
        margin-bottom: var(--space-lg);
        direction: rtl;
      }
      .footer__flip > * {
        direction: ltr;
      }
      .footer__flip-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-lg);
      }
      .footer__flip-visual {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
      }

      .footer__section-title {
        font-family: var(--font-heading);
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: var(--space-sm);
        color: var(--color-text);
      }

      .footer__item {
        margin-bottom: var(--space-xs);
        font-size: 0.85rem;
        line-height: 1.5;
        color: var(--color-text-muted);
      }

      .footer__item a {
        color: var(--color-text);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .footer__social {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
      }

      .footer__social-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: underline;
        text-underline-offset: 2px;
        color: var(--color-text);
      }

      .footer__divider {
        border: none;
        border-top: 1px solid var(--color-border);
        margin-bottom: var(--space-lg);
      }


      .footer__bottom {
        text-align: center;
        font-size: 0.75rem;
        color: var(--color-text-muted);
      }

      .footer__bottom p {
        margin-bottom: var(--space-xs);
      }

      .section-title {
        font-family: var(--font-heading);
        font-size: 2.5rem;
        text-align: center;
        margin-bottom: var(--space-lg);
        font-weight: 700;
        color: var(--color-text);
      }

      @media (max-width: 768px) {
        .hamburger { display: flex; }
        .nav { display: none; }
        .header { flex-wrap: nowrap; gap: 0; padding: var(--space-sm) var(--space-md); }
        .header__logo-img { width: 48px; height: 48px; }
        .main { padding: var(--space-md); }
        .section-title { font-size: 1.75rem; margin-bottom: var(--space-md); }
        .categories { padding: var(--space-lg) 0; }
        .destacados { padding: var(--space-lg) 0; }
        .footer__flip { grid-template-columns: 1fr; gap: var(--space-lg); direction: ltr; }
        .footer__actions { flex-direction: column; align-items: center; }
        .info-strip__inner { flex-direction: column; align-items: center; gap: var(--space-xs); }
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t("accessibility.skipToContent")}</a>

    <header class="header glass" role="banner" id="header">
      <a href="/" class="header__brand">
        <img src="/images/luisito-logo-rotiseria-mdq(2)-remove-bg-io.png" alt="Luisito Playa Grande" class="header__logo-img" />
      </a>
      <button class="hamburger" id="hamburger-btn" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
      <nav class="nav" aria-label={t("accessibility.navLabel")}>
        <ul class="nav__list">
          <li><a href="/" class="nav__link">{t("nav.home")}</a></li>
          <li><a href="/menu" class="nav__link">{t("nav.menu")}</a></li>
          <li><a href="/contact" class="nav__link">{t("nav.contact")}</a></li>
        </ul>
        <div class="nav__controls">
          <a href={whatsappUrl} target="_blank" rel="noopener" class="nav__cta-wpp"><Icon name="lucide:message-circle" size={14} /> {t("nav.wpp")}</a>
          <button class="cart-toggle" id="cart-toggle-btn" aria-label={t("nav.order")}>
            <Icon name="lucide:shopping-bag" size={16} /> {t("nav.order")}<span id="cart-badge"></span>
          </button>
          <LanguageSwitcher />
        </div>
      </nav>
    </header>

    <div class="mobile-nav" id="mobile-nav">
      <div class="mobile-nav__overlay" id="mobile-nav-overlay"></div>
      <div class="mobile-nav__panel">
        <div class="mobile-nav__header">
          <span class="mobile-nav__title" data-i18n="nav.menu">Menú</span>
          <button class="mobile-nav__close" id="mobile-nav-close" aria-label="Cerrar">✕</button>
        </div>
        <ul class="mobile-nav__list">
          <li><a href="/" class="mobile-nav__link" data-i18n="nav.home">{t("nav.home")}</a></li>
          <li><a href="/menu" class="mobile-nav__link" data-i18n="nav.menu">{t("nav.menu")}</a></li>
          <li><a href="/contact" class="mobile-nav__link" data-i18n="nav.contact">{t("nav.contact")}</a></li>
        </ul>
        <div class="mobile-nav__actions">
          <a href={whatsappUrl} target="_blank" rel="noopener" class="mobile-nav__wpp"><Icon name="lucide:message-circle" size={16} /> {t("nav.wpp")}</a>
          <button class="mobile-nav__cart" id="mobile-nav-cart"><Icon name="lucide:shopping-bag" size={16} /> {t("nav.order")}</button>
          <div class="mobile-nav__lang"><LanguageSwitcher /></div>
        </div>
      </div>
    </div>

    <main id="main-content" class="main" role="main">
      <slot />
    </main>

    <section class="info-strip">
      <div class="info-strip__inner">
        <span class="info-strip__item">{t("contact.address")}</span>
        <span class="info-strip__item">{t("contact.hours")}</span>
        <span class="info-strip__item"><a href={whatsappUrl} target="_blank" rel="noopener">{t("contact.phone")}</a></span>
      </div>
    </section>

    <footer class="footer" role="contentinfo" aria-label={t("accessibility.footerLabel")}>
      <div class="footer__inner">

        <div class="footer__flip">
          <div class="footer__flip-content">
            <div>
              <p class="footer__section-title">Contacto</p>
              <p class="footer__item">{t("contact.address")}</p>
              <p class="footer__item">{t("contact.phone")}</p>
            </div>
            <div>
              <p class="footer__section-title">Horarios</p>
              <p class="footer__item">{t("contact.hours")}</p>
            </div>
            <div>
              <p class="footer__section-title">Redes</p>
              <div class="footer__social">
                <a href={instagramUrl} target="_blank" rel="noopener" class="footer__social-link"><Icon name="lucide:instagram" size={14} /> Instagram</a>
                <a href={whatsappUrl} target="_blank" rel="noopener" class="footer__social-link"><Icon name="lucide:message-circle" size={14} /> WhatsApp</a>
              </div>
            </div>
          </div>
          <div class="footer__flip-visual">
            <img src="/images/luisito-logo-rotiseria-mdq(2)-remove-bg-io.png" alt="Luisito Playa Grande" class="footer__logo-img" />
            <p class="footer__since">Un clásico de Playa Grande desde 1955</p>
          </div>
        </div>

        <hr class="footer__divider" />

        
        <div class="footer__bottom">
          <p>{t("footer.copyright", { year: new Date().getFullYear() })}</p>
          <p class="footer__made">Hecho con amor en Mar del Plata</p>
        </div>
      </div>
    </footer>

    <Lightbox />
    <CartModal />

    <svg class="noise-overlay" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
      <filter id="vintage-noise">
        <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch" />
        <feColorMatrix type="saturate" values="0" />
      </filter>
      <rect width="100%" height="100%" filter="url(#vintage-noise)" />
    </svg>
    <Analytics />
    <SpeedInsights />

    <script>
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      gsap.registerPlugin(ScrollTrigger);

      window.addEventListener("load", () => {
        gsap.to(".hero", {
          backgroundPosition: "50% 20%",
          ease: "none",
          scrollTrigger: { trigger: ".hero", start: "top top", end: "bottom top", scrub: 1 },
        });

        ScrollTrigger.create({
          start: "top -80px",
          onEnter: () => document.getElementById("header")?.classList.add("header--scrolled"),
          onLeaveBack: () => document.getElementById("header")?.classList.remove("header--scrolled"),
        });
      });
    </script>

    <script>
      function openMobileNav() {
        document.getElementById("mobile-nav")?.classList.add("mobile-nav--open");
        document.getElementById("hamburger-btn")?.classList.add("active");
        document.body.classList.add("modal-open");
      }
      function closeMobileNav() {
        document.getElementById("mobile-nav")?.classList.remove("mobile-nav--open");
        document.getElementById("hamburger-btn")?.classList.remove("active");
        document.body.classList.remove("modal-open");
      }

      document.getElementById("hamburger-btn")?.addEventListener("click", openMobileNav);
      document.getElementById("mobile-nav-close")?.addEventListener("click", closeMobileNav);
      document.getElementById("mobile-nav-overlay")?.addEventListener("click", closeMobileNav);
      document.getElementById("mobile-nav-cart")?.addEventListener("click", () => { closeMobileNav(); window.openCartModal?.(); });
      document.querySelectorAll(".mobile-nav__link").forEach((link) => link.addEventListener("click", closeMobileNav));
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeMobileNav(); });
    </script>

    <script>
      const badge = document.getElementById("cart-badge");
      function updateBadge() {
        if (!badge) return;
        try {
          const items = JSON.parse(localStorage.getItem("luisito-cart") || "[]");
          const count = items.reduce((s, i) => s + i.qty, 0);
          if (count > 0) { badge.textContent = String(count); badge.style.display = "inline-flex"; }
          else { badge.textContent = ""; badge.style.display = "none"; }
        } catch {}
      }
      updateBadge();

      function openCartModal() {
        const modal = document.getElementById("cart-modal");
        if (!modal) return;
        modal.classList.add("cart-modal--open");
        document.body.classList.add("modal-open");
        if (window.CART_RENDER) window.CART_RENDER();
      }

      function closeCartModal() {
        const modal = document.getElementById("cart-modal");
        if (!modal) return;
        modal.classList.remove("cart-modal--open");
        document.body.classList.remove("modal-open");
      }

      document.getElementById("cart-toggle-btn")?.addEventListener("click", openCartModal);

      document.addEventListener("click", function(e) {
        var target = e.target;
        if (target && (target.getAttribute("data-cart-close") !== null || target.closest("[data-cart-close]"))) {
          closeCartModal();
        }
      });

      document.addEventListener("keydown", function(e) {
        if (e.key === "Escape") closeCartModal();
      });

      window.openCartModal = openCartModal;
      window.closeCartModal = closeCartModal;
      window.updateCartBadge = updateBadge;
    </script>

    <script define:vars={{ esData: es, enData: en }}>
      function resolveKey(obj, key) {
        return key.split(".").reduce((o, k) => (o && o[k] !== undefined ? o[k] : undefined), obj);
      }

      function applyLocale(locale) {
        var locales = { es: esData, en: enData };
        if (!locales[locale]) return;
        document.documentElement.lang = locale;

        document.querySelectorAll("[data-i18n]").forEach(function(el) {
          var key = el.getAttribute("data-i18n");
          var value = resolveKey(locales[locale], key);
          if (typeof value === "string") el.textContent = value;
        });

        document.querySelectorAll("[data-i18n-attr]").forEach(function(el) {
          var key = el.getAttribute("data-i18n-attr");
          var attr = el.getAttribute("data-i18n-attr-name") || "aria-label";
          var value = resolveKey(locales[locale], key);
          if (typeof value === "string") el.setAttribute(attr, value);
        });

        localStorage.setItem("locale", locale);
      }

      var stored = localStorage.getItem("locale");
      if (stored && stored !== document.documentElement.lang) {
        applyLocale(stored);
      }

      window.applyLocale = applyLocale;
    </script>
  </body>
</html>
