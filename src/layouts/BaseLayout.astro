---
import Seo from "../components/Seo.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { t, getLocale } from "../utils/i18n";
import type { SeoProps } from "../components/Seo.astro";


export interface Props extends SeoProps {}

const locale = getLocale();
const { title, description, jsonLd } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Inter:wght@400;600;700;800&family=Playfair+Display:wght@600;700;900&display=swap" rel="stylesheet" />
    <Seo {title} {description} {jsonLd} />
    <style>
      :root {
        --color-bg: #e8f4f8;
        --color-bg-alt: #d0e8f0;
        --color-text: #000;
        --color-text-muted: #000;
        --color-primary: #0d7986;
        --color-primary-hover: #0a5f6a;
        --color-accent: #f5c800;
        --color-border: #000;
        --color-focus: #0d7986;
        --color-cream: #fff5e0;
        --font-sans: "Inter", system-ui, sans-serif;
        --font-display: "Bangers", "Inter", system-ui, cursive;
        --font-serif: "Playfair Display", "Georgia", serif;
        --border-width: 0;
        --space-xs: 0.25rem;
        --space-sm: 0.5rem;
        --space-md: 1rem;
        --space-lg: 2rem;
        --space-xl: 4rem;
        --max-width: 1100px;
        --glass-bg: rgba(232, 244, 248, 0.85);
        --glass-border: 1px solid rgba(255, 255, 255, 0.4);
        --glass-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
        --glass-blur: 12px;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }

      body {
        font-family: var(--font-sans);
        color: var(--color-text);
        background: var(--color-bg);
        line-height: 1.6;
        min-height: 100vh;
      }

      a {
        color: var(--color-primary);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      a:hover { color: var(--color-primary-hover); }

      a:focus-visible, button:focus-visible {
        outline: 3px solid var(--color-focus);
        outline-offset: 2px;
      }

      .glass {
        background: var(--glass-bg);
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
        box-shadow: var(--glass-shadow);
        border: var(--glass-border);
      }

      .skip-link {
        position: absolute;
        top: -100%;
        left: var(--space-md);
        padding: var(--space-sm) var(--space-md);
        background: var(--color-primary);
        color: #fff;
        z-index: 1000;
        font-weight: 700;
        text-decoration: none;
      }
      .skip-link:focus { top: 0; }

      .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--space-md) var(--space-lg);
        max-width: var(--max-width);
        margin: 0 auto;
        position: sticky;
        top: 0;
        z-index: 100;
      }

      .header__brand {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        text-decoration: none;
        color: var(--color-text);
      }

      .header__logo-img {
        width: 72px;
        height: 72px;
        object-fit: contain;
      }

      .header__title {
        font-family: var(--font-display);
        font-size: 1.75rem;
        letter-spacing: 4px;
        color: var(--color-text);
      }

      .nav {
        display: flex;
        align-items: center;
        gap: var(--space-lg);
      }

      .nav__list {
        display: flex;
        gap: var(--space-md);
        list-style: none;
      }

      .nav__link {
        font-family: var(--font-display);
        font-size: 1.125rem;
        color: var(--color-text);
        text-decoration: none;
        padding: var(--space-xs) var(--space-sm);
        letter-spacing: 2px;
        transition: color 0.15s;
      }

      .nav__link:hover { color: var(--color-primary); }

      .nav__controls {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
      }

      .btn--icon {
        background: var(--color-accent);
        padding: var(--space-sm) var(--space-md);
        cursor: pointer;
        font-weight: 700;
        font-size: 0.875rem;
        transition: transform 0.15s;
      }

      .btn--icon:hover { transform: scale(1.1); }

      .lang-btn {
        font-family: var(--font-display);
        letter-spacing: 2px;
      }

      .cart-toggle {
        position: relative;
        font-size: 1.25rem;
      }

      #cart-badge {
        position: absolute;
        top: -6px;
        right: -6px;
        background: var(--color-primary);
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        width: 20px;
        height: 20px;
        border-radius: 999px;
        display: none;
        align-items: center;
        justify-content: center;
      }

      .main {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: var(--space-lg);
        min-height: 70vh;
      }

      .footer {
        text-align: center;
        padding: var(--space-lg);
        margin-top: var(--space-xl);
      }

      .footer__tagline {
        font-family: var(--font-serif);
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-text);
        margin-bottom: var(--space-sm);
      }

      .footer p {
        color: var(--color-text);
        font-size: 0.875rem;
      }

      .section-title {
        font-family: var(--font-serif);
        font-size: 2.5rem;
        text-align: center;
        margin-bottom: var(--space-lg);
        font-weight: 700;
        color: var(--color-text);
      }

      @media (max-width: 768px) {
        .header { flex-wrap: wrap; gap: var(--space-sm); }
        .nav { order: 3; width: 100%; justify-content: space-between; }
        .nav__list { gap: var(--space-xs); }
        .nav__link { font-size: 1rem; }
        .section-title { font-size: 1.75rem; }
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t("accessibility.skipToContent")}</a>

    <header class="header glass" role="banner">
      <a href="/" class="header__brand">
        <img src="/images/luisito-logo-rotiseria-mdq(1).jpg" alt="Luisito Playa Grande" class="header__logo-img" />
      </a>
      <nav class="nav" aria-label={t("accessibility.navLabel")}>
        <ul class="nav__list">
          <li><a href="/" class="nav__link">{t("nav.home")}</a></li>
          <li><a href="/menu" class="nav__link">{t("nav.menu")}</a></li>
          <li><a href="/contact" class="nav__link">{t("nav.contact")}</a></li>
        </ul>
        <div class="nav__controls">
          <a href="/pedido" class="btn--icon cart-toggle" aria-label={t("nav.order")}>
            🛒<span id="cart-badge"></span>
          </a>
          <LanguageSwitcher />
        </div>
      </nav>
    </header>

    <main id="main-content" class="main" role="main">
      <slot />
    </main>

    <footer class="footer" role="contentinfo" aria-label={t("accessibility.footerLabel")}>
      <p class="footer__tagline">{t("footer.tagline")}</p>
      <p>{t("footer.copyright", { year: new Date().getFullYear() })}</p>
    </footer>

    <script>
      const badge = document.getElementById("cart-badge");
      if (badge) {
        try {
          const items = JSON.parse(localStorage.getItem("luisito-cart") || "[]");
          const count = items.reduce((s, i) => s + i.qty, 0);
          if (count > 0) { badge.textContent = String(count); badge.style.display = "flex"; }
        } catch {}
      }
    </script>
  </body>
</html>
