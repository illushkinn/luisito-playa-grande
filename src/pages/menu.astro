---
import BaseLayout from "../layouts/BaseLayout.astro";
import MenuCard from "../components/MenuCard.astro";
import { t } from "../utils/i18n";
import { MENU_ITEMS } from "../utils/cart";

const categories = ["platos", "pizzas", "empanadas", "bebidas", "postres"] as const;
---

<BaseLayout title={`${t("menu.title")} | ${t("site.title")}`} description={t("site.description")}>
  <section>
    <h1 class="section-title" data-i18n="menu.title">{t("menu.title")}</h1>
    <p class="menu__subtitle" data-i18n="menu.subtitle">{t("menu.subtitle")}</p>

    {categories.map((cat) => {
      const items = MENU_ITEMS.filter((i) => i.category === cat);
      if (items.length === 0) return null;
      return (
        <div class="menu-section">
          <h2 class="menu-section__title" data-i18n={`menu.categories.${cat}`}>{t(`menu.categories.${cat}`)}</h2>
          <div class="menu-section__grid">
            {items.map((item) => (
              <MenuCard
                id={item.id}
                name={item.name}
                price={item.price}
                category={item.category}
              />
            ))}
          </div>
        </div>
      );
    })}

    <div class="menu__footer">
      <a href="/pedido" class="hero__cta hero__cta--primary" data-i18n="nav.order">
        🛒 {t("nav.order")}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .menu__subtitle {
    text-align: center;
    color: var(--color-text);
    margin-bottom: var(--space-xl);
    font-size: 1rem;
    margin-top: calc(-1 * var(--space-md));
  }

  .menu-section {
    margin-bottom: var(--space-xl);
  }

  .menu-section__title {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: var(--space-md);
    color: var(--color-text);
  }

  .menu-section__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--space-lg);
  }

  .menu__footer {
    text-align: center;
    padding: var(--space-lg) 0;
  }

  .hero__cta {
    display: inline-block;
    padding: var(--space-sm) var(--space-xl);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: var(--radius-md);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    transition: transform 0.15s, box-shadow 0.2s;
  }

  .hero__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.12);
  }
  .hero__cta--primary { background: var(--color-primary); color: #fff; }
</style>
