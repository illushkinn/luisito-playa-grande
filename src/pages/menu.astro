---
import BaseLayout from "../layouts/BaseLayout.astro";
import MenuCard from "../components/MenuCard.astro";
import { t } from "../utils/i18n";
import { MENU_ITEMS } from "../utils/cart";

const categories = ["platos", "pizzas", "empanadas", "tartas", "pollo-rostizado", "bebidas", "postres"] as const;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Menu",
  name: t("menu.title"),
  description: t("site.descriptionMenu"),
  url: Astro.url.href,
  hasMenuItem: MENU_ITEMS.map((item) => ({
    "@type": "MenuItem",
    name: item.name,
    offers: {
      "@type": "Offer",
      price: item.price,
      priceCurrency: "ARS",
    },
    category: item.category,
  })),
};
---

<BaseLayout title={`${t("menu.title")} | ${t("site.title")}`} description={t("site.descriptionMenu")} jsonLd={jsonLd}>
  <section>
    <h1 class="section-title" data-i18n="menu.title">{t("menu.title")}</h1>
    <p class="menu__subtitle" data-i18n="menu.subtitle">{t("menu.subtitle")}</p>

    {categories.map((cat) => {
      const items = MENU_ITEMS.filter((i) => i.category === cat);
      if (items.length === 0) return null;
      return (
        <div class="menu-section" id={cat}>
          <h2 class="menu-section__title" data-i18n={`menu.categories.${cat}`}>{t(`menu.categories.${cat}`)}</h2>
          <div class="menu-section__grid">
            {items.map((item) => (
              <MenuCard
                id={item.id}
                name={item.name}
                price={item.price}
                category={item.category}
              />
            ))}
          </div>
        </div>
      );
    })}

    <div class="menu__footer">
      <button class="hero__cta hero__cta--primary" onclick="openCartModal()">
        <span data-i18n="nav.order">{t("nav.order")}</span>
      </button>
    </div>
  </section>
</BaseLayout>

<style>
  .menu__subtitle {
    text-align: center;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
    font-size: 1rem;
    margin-top: calc(-1 * var(--space-md));
  }

  .menu-section {
    margin-bottom: var(--space-xl);
  }

  .menu-section__title {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: 0;
    margin-bottom: var(--space-md);
    color: var(--color-text);
  }

  .menu-section__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--space-lg);
  }

  .menu__footer {
    text-align: center;
    padding: var(--space-lg) 0;
  }

  .hero__cta {
    display: inline-block;
    padding: var(--space-sm) var(--space-xl);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.5px;
    text-decoration: none;
    background: var(--color-primary);
    color: #fff;
    border: 2px solid var(--color-text);
    border-radius: var(--radius-sm);
    box-shadow: 4px 4px 0 var(--color-text);
    transition: transform 0.1s, box-shadow 0.1s;
    cursor: pointer;
  }

  .hero__cta:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--color-text);
    color: #fff;
  }
  .hero__cta:active {
    transform: translate(1px, 1px) scale(0.96);
    box-shadow: 2px 2px 0 var(--color-text);
  }
</style>
