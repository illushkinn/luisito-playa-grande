---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../utils/i18n";
---

<BaseLayout title={`${t("order.title")} | ${t("site.title")}`} description={t("site.description")}>
  <section>
    <h1 class="section-title">{t("order.title")}</h1>

    <div id="cart-empty" class="cart-empty">
      <div class="cart-empty__emoji">🛒</div>
      <p class="cart-empty__text">{t("order.empty")}</p>
      <a href="/menu" class="hero__cta hero__cta--primary">{t("order.emptyCta")}</a>
    </div>

    <div id="cart-content" class="cart-content" style="display:none">
      <div id="cart-items" class="cart-items"></div>

      <div class="cart-summary">
        <div class="cart-summary__row">
          <span>{t("order.subtotal")}</span>
          <span id="cart-subtotal">$0</span>
        </div>
        <div class="cart-summary__row cart-summary__row--total">
          <span>{t("order.total")}</span>
          <span id="cart-total">$0</span>
        </div>
      </div>

      <div class="cart-service">
        <h3 class="cart-service__title">{t("order.serviceType")}</h3>
        <div class="cart-service__options">
          <label class="cart-service__option">
            <input type="radio" name="service" value="delivery" checked />
            <span>🚚 {t("order.delivery")}</span>
          </label>
          <label class="cart-service__option">
            <input type="radio" name="service" value="takeaway" />
            <span>🏪 {t("order.takeaway")}</span>
          </label>
        </div>
      </div>

      <div id="address-field" class="cart-address">
        <label for="address-input">{t("order.address")}</label>
        <input type="text" id="address-input" placeholder={t("order.addressPlaceholder")} />
      </div>

      <div class="cart-notes">
        <label for="notes-input">{t("order.notes")}</label>
        <textarea id="notes-input" placeholder={t("order.notesPlaceholder")} rows="2"></textarea>
      </div>

      <button id="send-wpp" class="cart-send">
        📱 {t("order.send")}
      </button>
    </div>
  </section>
</BaseLayout>

<script>
  import { getCart, updateQty, removeFromCart, getCartTotal, getCartCount, generateWhatsAppMessage, openWhatsApp } from "../utils/cart";

  function renderCart() {
    const items = getCart();
    const empty = document.getElementById("cart-empty")!;
    const content = document.getElementById("cart-content")!;
    const container = document.getElementById("cart-items")!;

    if (items.length === 0) {
      empty.style.display = "block";
      content.style.display = "none";
      return;
    }

    empty.style.display = "none";
    content.style.display = "block";

    container.innerHTML = items.map((item) => `
      <div class="cart-item" data-id="${item.id}">
        <div class="cart-item__info">
          <h4 class="cart-item__name">${item.name}</h4>
          <p class="cart-item__price">$${(item.price * item.qty).toLocaleString("es-AR")}</p>
        </div>
        <div class="cart-item__qty">
          <button class="qty-btn" data-dec="${item.id}">−</button>
          <span class="qty-value">${item.qty}</span>
          <button class="qty-btn" data-inc="${item.id}">+</button>
        </div>
        <button class="cart-item__remove" data-remove="${item.id}" aria-label="Eliminar">✕</button>
      </div>
    `).join("");

    updateTotals(items);

    container.querySelectorAll("[data-dec]").forEach((btn) =>
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-dec")!;
        const item = items.find((i) => i.id === id);
        if (item && item.qty > 1) updateQty(id, item.qty - 1);
        else removeFromCart(id);
        renderCart();
        updateBadge();
      })
    );

    container.querySelectorAll("[data-inc]").forEach((btn) =>
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-inc")!;
        const item = items.find((i) => i.id === id);
        if (item) updateQty(id, item.qty + 1);
        renderCart();
        updateBadge();
      })
    );

    container.querySelectorAll("[data-remove]").forEach((btn) =>
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-remove")!;
        removeFromCart(id);
        renderCart();
        updateBadge();
      })
    );
  }

  function updateTotals(items) {
    const subtotal = getCartTotal(items);
    document.getElementById("cart-subtotal")!.textContent = "$" + subtotal.toLocaleString("es-AR");
    document.getElementById("cart-total")!.textContent = "$" + subtotal.toLocaleString("es-AR");
  }

  function updateBadge() {
    const badge = document.getElementById("cart-badge");
    if (badge) {
      const items = getCart();
      const count = getCartCount(items);
      badge.textContent = count > 0 ? String(count) : "";
      badge.style.display = count > 0 ? "flex" : "none";
    }
  }

  function setupServiceToggle() {
    document.querySelectorAll("[name=service]").forEach((radio) =>
      radio.addEventListener("change", () => {
        const isDelivery = radio.value === "delivery";
        document.getElementById("address-field")!.style.display = isDelivery ? "block" : "none";
      })
    );
  }

  function setupSend() {
    document.getElementById("send-wpp")!.addEventListener("click", () => {
      const items = getCart();
      const type = (document.querySelector("[name=service]:checked") as HTMLInputElement).value;
      const address = (document.getElementById("address-input") as HTMLInputElement).value;
      const notes = (document.getElementById("notes-input") as HTMLTextAreaElement).value;

      if (type === "delivery" && !address.trim()) {
        alert("Por favor ingresá tu dirección de entrega");
        return;
      }

      const msg = generateWhatsAppMessage({ items, type: type as any, address, notes, phone: "" });
      openWhatsApp(msg);
    });
  }

  renderCart();
  setupServiceToggle();
  setupSend();

  const deliveryRadio = document.querySelector("[value=delivery]") as HTMLInputElement;
  if (deliveryRadio) deliveryRadio.checked = true;
</script>

<style>
  .cart-empty {
    text-align: center;
    padding: var(--space-xl) 0;
  }

  .cart-empty__emoji { font-size: 4rem; margin-bottom: var(--space-md); }

  .cart-empty__text {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }

  .hero__cta {
    display: inline-block;
    padding: var(--space-sm) var(--space-xl);
    border: var(--border-width) solid var(--color-text);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 2px;
    text-decoration: none;
    transition: transform 0.15s;
  }
  .hero__cta:hover { transform: scale(1.05); }
  .hero__cta--primary { background: var(--color-primary); color: #fff; }

  .cart-content { max-width: 600px; margin: 0 auto; }

  .cart-items { margin-bottom: var(--space-lg); }

  .cart-item {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    border: var(--border-width) solid var(--color-border);
    border-radius: 12px;
    margin-bottom: var(--space-md);
    background: var(--color-bg);
  }

  .cart-item__info { flex: 1; }
  .cart-item__name { font-weight: 700; margin-bottom: 2px; }
  .cart-item__price { color: var(--color-primary); font-weight: 600; }

  .cart-item__qty {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .qty-btn {
    width: 32px;
    height: 32px;
    border: var(--border-width) solid var(--color-text);
    border-radius: 999px;
    background: var(--color-accent);
    font-weight: 700;
    font-size: 1.125rem;
    cursor: pointer;
  }

  .qty-value {
    font-weight: 700;
    font-size: 1.125rem;
    min-width: 24px;
    text-align: center;
  }

  .cart-item__remove {
    background: none;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
    padding: var(--space-xs);
    color: var(--color-text-muted);
  }

  .cart-summary {
    border-top: var(--border-width) dashed var(--color-border);
    padding-top: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .cart-summary__row {
    display: flex;
    justify-content: space-between;
    padding: var(--space-xs) 0;
  }

  .cart-summary__row--total {
    font-size: 1.25rem;
    font-weight: 800;
    border-top: var(--border-width) solid var(--color-border);
    padding-top: var(--space-sm);
    margin-top: var(--space-xs);
  }

  .cart-service {
    margin-bottom: var(--space-lg);
  }

  .cart-service__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin-bottom: var(--space-sm);
  }

  .cart-service__options {
    display: flex;
    gap: var(--space-md);
  }

  .cart-service__option {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border: var(--border-width) solid var(--color-border);
    border-radius: 999px;
    cursor: pointer;
    font-weight: 600;
  }

  .cart-service__option:has(input:checked) {
    border-color: var(--color-primary);
    background: var(--color-accent);
  }

  .cart-address, .cart-notes {
    margin-bottom: var(--space-lg);
  }

  .cart-address label, .cart-notes label {
    display: block;
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .cart-address input, .cart-notes textarea {
    width: 100%;
    padding: var(--space-sm) var(--space-md);
    border: var(--border-width) solid var(--color-border);
    border-radius: 8px;
    font-family: inherit;
    font-size: 1rem;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .cart-send {
    width: 100%;
    padding: var(--space-md);
    border: var(--border-width) solid var(--color-text);
    border-radius: 999px;
    background: #25d366;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 2px;
    cursor: pointer;
    transition: transform 0.15s;
  }

  .cart-send:hover { transform: scale(1.02); }
</style>
