---
import BaseLayout from "../layouts/BaseLayout.astro";
import SplitHero from "../components/SplitHero.astro";
import { t } from "../utils/i18n";
import { MENU_ITEMS } from "../utils/cart";

const destacados = MENU_ITEMS.filter((_, i) => i < 4);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  name: "Luisito Playa Grande",
  description: t("site.description"),
  url: Astro.url.origin,
  telephone: "223 544-0230",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Bernardo De Irigoyen 3537",
    addressLocality: "Mar del Plata",
    addressRegion: "Buenos Aires",
    addressCountry: "AR",
  },
  servesCuisine: ["Argentina", "Pizzas", "Parrilla"],
};
---

<BaseLayout title={t("site.title")} description={t("site.description")} jsonLd={jsonLd}>
  <SplitHero />

  <section class="destacados">
    <h2 class="section-title">🌟 Destacados</h2>
    <div class="destacados__grid">
      {destacados.map((item) => (
        <div class="destacado-card">
          <div class="destacado-card__emoji">
            {item.category === "pizzas" ? "🍕" : item.category === "empanadas" ? "🥟" : item.category === "bebidas" ? "🥤" : item.category === "postres" ? "🍰" : "🍽️"}
          </div>
          <h3 class="destacado-card__name">{item.name}</h3>
          <p class="destacado-card__price">${item.price.toLocaleString("es-AR")}</p>
          <button class="destacado-card__btn" data-add={item.id} data-name={item.name} data-price={item.price}>
            🛒 {t("menu.add")}
          </button>
        </div>
      ))}
    </div>
    <div class="destacados__cta">
      <a href="/menu" class="hero__cta hero__cta--primary">{t("hero.cta")}</a>
    </div>
  </section>
</BaseLayout>

<script>
  import { addToCart } from "../utils/cart";
  document.querySelectorAll("[data-add]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.getAttribute("data-add")!;
      const name = btn.getAttribute("data-name")!;
      const price = parseInt(btn.getAttribute("data-price")!);
      addToCart({ id, name, price, qty: 1, category: "" } as any);
      btn.innerHTML = "✅ Agregado";
      setTimeout(() => { btn.innerHTML = "🛒 Agregar"; }, 1500);
      const badge = document.getElementById("cart-badge");
      if (badge) {
        const items = JSON.parse(localStorage.getItem("luisito-cart") || "[]");
        const count = items.reduce((s, i) => s + i.qty, 0);
        badge.textContent = count > 0 ? String(count) : "";
        badge.style.display = count > 0 ? "flex" : "none";
      }
    });
  });
</script>

<style>
  .destacados {
    padding: var(--space-xl) 0;
  }

  .destacados__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .destacado-card {
    border: var(--border-width) solid var(--color-text);
    padding: var(--space-lg);
    text-align: center;
    background: var(--color-bg);
    transition: transform 0.2s;
  }

  .destacado-card:hover { transform: scale(1.03); }

  .destacado-card__emoji {
    font-size: 3rem;
    margin-bottom: var(--space-sm);
    filter: grayscale(0.5);
  }

  .destacado-card__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin-bottom: var(--space-xs);
  }

  .destacado-card__price {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: var(--space-md);
  }

  .destacado-card__btn {
    border: var(--border-width) solid var(--color-text);
    padding: var(--space-sm) var(--space-lg);
    background: var(--color-accent);
    color: var(--color-text);
    font-weight: 700;
    cursor: pointer;
    font-size: 0.875rem;
    transition: transform 0.15s;
  }

  .destacado-card__btn:hover { transform: scale(1.05); }

  .destacados__cta { text-align: center; }

  @media (max-width: 768px) {
    .hero__title { font-size: 2.5rem; }
    .hero__logo { width: 120px; height: 120px; }
  }
</style>
