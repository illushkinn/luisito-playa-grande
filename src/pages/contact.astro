---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { t } from "../utils/i18n";
---

<BaseLayout title={`${t("contact.title")} | ${t("site.title")}`} description={t("site.descriptionContact")}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Restaurant",
    name: "Luisito Playa Grande",
    description: t("site.descriptionContact"),
    url: Astro.url.origin,
    telephone: "223 544-0230",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Bernardo De Irigoyen 3537",
      addressLocality: "Mar del Plata",
      addressRegion: "Buenos Aires",
      addressCountry: "AR",
    },
    openingHoursSpecification: [
      { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"], opens: "10:00", closes: "14:00" },
      { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"], opens: "17:00", closes: "21:30" },
    ],
    areaServed: "Mar del Plata",
    sameAs: ["https://www.instagram.com/luisito.playagrande/"],
  })} />
  <section class="contact">
    <h1 class="section-title" data-i18n="contact.title">{t("contact.title")}</h1>

    <div class="contact__card">
      <div class="contact__row">
        <Icon name="lucide:map-pin" size={18} class="contact__icon" />
        <div>
          <p class="contact__label">Direccion</p>
          <p class="contact__value" data-i18n="contact.address">{t("contact.address")}</p>
        </div>
      </div>
      <div class="contact__row">
        <Icon name="lucide:phone" size={18} class="contact__icon" />
        <div>
          <p class="contact__label">Telefono</p>
          <p class="contact__value" data-i18n="contact.phone">{t("contact.phone")}</p>
        </div>
      </div>
      <div class="contact__row">
        <Icon name="lucide:clock" size={18} class="contact__icon" />
        <div>
          <p class="contact__label">Horarios</p>
          <p class="contact__value" data-i18n="contact.hours">{t("contact.hours")}</p>
        </div>
      </div>
      <div class="contact__row">
        <Icon name="lucide:camera" size={18} class="contact__icon" />
        <div>
          <p class="contact__label">Instagram</p>
          <p class="contact__value">
            <a href="https://www.instagram.com/luisito.playagrande/" target="_blank" rel="noopener">
              @luisito.playagrande
            </a>
          </p>
        </div>
      </div>
    </div>

    <div class="contact__actions">
      <a href="https://wa.me/5492235440230" target="_blank" rel="noopener" class="hero__cta hero__cta--wpp" data-i18n="contact.cta">
        {t("contact.cta")}
      </a>
    </div>

    <div class="contact__map">
      <iframe
        src="https://maps.google.com/maps?q=Bernardo%20De%20Irigoyen%203537%20Mar%20del%20Plata&output=embed"
        width="100%"
        height="280"
        style="border:0; border-radius: var(--radius-md);"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Ubicación Luisito Playa Grande"
      ></iframe>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { max-width: 500px; margin: 0 auto; }

  .contact__card {
    padding: var(--space-lg);
    margin-bottom: var(--space-lg);
    background: var(--card-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--glass-shadow);
    border-radius: var(--radius-md);
  }

  .contact__row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-md) 0;
  }

  .contact__icon {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--color-primary);
  }

  .contact__label {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin-bottom: 2px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .contact__value {
    font-family: var(--font-body);
    font-weight: 500;
  }

  .contact__actions { text-align: center; }
  .contact__map { margin-top: var(--space-lg); }

  .hero__cta {
    display: inline-block;
    padding: var(--space-sm) var(--space-xl);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: 0.5px;
    text-decoration: none;
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.1);
    transition: transform 0.15s, box-shadow 0.2s;
  }
  .hero__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(37, 211, 102, 0.15);
  }
  .hero__cta--wpp { background: #25d366; color: #fff; }
</style>
